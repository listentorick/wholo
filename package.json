{
  "name": "wholo",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@wholo/api",
    "dev:portal": "turbo run dev --filter=@wholo/portal",
    "dev:admin-api": "turbo run dev --filter=@wholo/admin-api",
    "dev:admin": "turbo run dev --filter=@wholo/admin",
    "dev:driver-api": "turbo run dev --filter=@wholo/driver-api",
    "dev:driver": "turbo run dev --filter=@wholo/driver",
    "dev:www": "turbo run dev --filter=@wholo/www",
    "build": "turbo run build",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "type-check": "turbo run type-check",
    "db:migrate:dev": "pnpm --filter @wholo/api exec prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter @wholo/api exec prisma migrate deploy",
    "db:seed": "pnpm --filter @wholo/api exec tsx prisma/seed.ts",
    "helm:deps": "helm dependency update helm/wholo",
    "helm:install": "helm upgrade --install wholo helm/wholo -f helm/wholo/values.local.yaml",
    "helm:install:live": "helm upgrade --install wholo helm/wholo -n wholo -f helm/wholo/values.live.yaml",
    "helm:uninstall": "helm uninstall wholo",
    "k8s:build": "docker build -t wholo/api:local -f apps/api/Dockerfile . && docker build -t wholo/admin-api:local -f apps/admin-api/Dockerfile . && docker build -t wholo/portal-api:local -f apps/portal-api/Dockerfile . && docker build -t wholo/driver-api:local -f apps/driver-api/Dockerfile . && docker build -t wholo/www:local -f apps/www/Dockerfile . && docker build -t wholo/keycloak:local -f apps/keycloak/Dockerfile apps/keycloak",
    "k8s:pf:postgres": "kubectl port-forward svc/wholo-postgresql 5432:5432",
    "k8s:pf:redis": "kubectl port-forward svc/wholo-redis-master 6379:6379"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.25",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4"
}
