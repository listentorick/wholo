{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "schemaVersion": 39,
  "timezone": "",
  "weekStart": "",
  "description": "Off-cluster encrypted Postgres backups (ADR-069): when the last backup ran, whether it succeeded, and how old the newest successful backup is. Gauges sent by the pg-backup CronJob over StatsD. Restore procedure: docs/runbook/postgres-restore.md.",
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Latest backup",
      "type": "row"
    },
    {
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "description": "When the most recent backup attempt finished, successful or not.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "dateTimeAsIso",
          "displayName": "${__field.labels.environment}",
          "noValue": "No run in 7 days"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "pluginVersion": "11.2.0",
      "targets": [
        {
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"stocdup_backup_last_run_ts\" and r._field == \"value\")\n  |> filter(fn: (r) => r.environment =~ /^(${environment:regex})$/)\n  |> group(columns: [\"environment\"])\n  |> max()\n  |> map(fn: (r) => ({ r with _value: r._value * 1000.0 }))",
          "refId": "A"
        }
      ],
      "title": "Last backup run",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "description": "Outcome of the most recent backup attempt. A failed run is also an alert (Postgres backup failed).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Failed",
                  "index": 0
                },
                "1": {
                  "text": "Succeeded",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none",
          "displayName": "${__field.labels.environment}",
          "noValue": "No run in 7 days"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "pluginVersion": "11.2.0",
      "targets": [
        {
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"stocdup_backup_last_outcome\" and r._field == \"value\")\n  |> filter(fn: (r) => r.environment =~ /^(${environment:regex})$/)\n  |> group(columns: [\"environment\"])\n  |> last()",
          "refId": "A"
        }
      ],
      "title": "Last run outcome",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "description": "Time since the snapshot in the newest successful backup was taken \u2014 the data you would lose restoring now. Backups run every 6h; the Postgres backup stale alert fires above 13h.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 25200
              },
              {
                "color": "red",
                "value": 46800
              }
            ]
          },
          "unit": "s",
          "displayName": "${__field.labels.environment}",
          "noValue": "No successful backup in 7 days"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "pluginVersion": "11.2.0",
      "targets": [
        {
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"stocdup_backup_last_success_ts\" and r._field == \"value\")\n  |> filter(fn: (r) => r.environment =~ /^(${environment:regex})$/)\n  |> group(columns: [\"environment\"])\n  |> max()\n  |> map(fn: (r) => ({ r with _value: float(v: int(v: now())) / 1000000000.0 - r._value }))",
          "refId": "A"
        }
      ],
      "title": "Age of latest successful backup",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "description": "Compressed size of the newest successful backup (as stored, before encryption overhead).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "bytes",
          "displayName": "${__field.labels.environment}",
          "noValue": "No successful backup in 7 days"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "pluginVersion": "11.2.0",
      "targets": [
        {
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"stocdup_backup_size_bytes\" and r._field == \"value\")\n  |> filter(fn: (r) => r.environment =~ /^(${environment:regex})$/)\n  |> group(columns: [\"environment\"])\n  |> last()",
          "refId": "A"
        }
      ],
      "title": "Latest backup size",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "description": "Compressed size of each successful backup.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "bytes",
          "displayName": "${__field.labels.environment}",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "pluginVersion": "11.2.0",
      "targets": [
        {
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"stocdup_backup_size_bytes\" and r._field == \"value\")\n  |> filter(fn: (r) => r.environment =~ /^(${environment:regex})$/)\n  |> group(columns: [\"environment\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"environment\"])",
          "refId": "A"
        }
      ],
      "title": "Backup size",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "description": "Wall-clock duration of each backup attempt (dump, encrypt, upload, verify).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s",
          "displayName": "${__field.labels.environment}",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "pluginVersion": "11.2.0",
      "targets": [
        {
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"stocdup_backup_duration_s\" and r._field == \"value\")\n  |> filter(fn: (r) => r.environment =~ /^(${environment:regex})$/)\n  |> group(columns: [\"environment\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"environment\"])",
          "refId": "A"
        }
      ],
      "title": "Backup duration",
      "type": "timeseries"
    }
  ],
  "refresh": "5m",
