      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "message"
            },
            "properties": [
              {
                "id": "custom.width",
