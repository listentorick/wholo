  "description": "Aggregated pod logs (ADR-064). Node processes emit structured JSON via nestjs-pino (level / context / msg / reqId parsed with `| json`); www / keycloak / postgres / redis ship raw. Fed by Fluent Bit -> Loki. Explore -> Loki is the primary tool; this is the at-a-glance view.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 15,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{namespace=~\"$namespace\", app=~\"$app\"} | json | level=~\"$level\" |~ \"$search\" | line_format \"{{if .context}}[{{.context}}] {{end}}{{if .message}}{{.message}}{{else}}{{__line__}}{{end}}\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Logs",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
