        ]
      },
      "pluginVersion": "11.2.0",
      "targets": [
        {
          "expr": "{namespace=~\"$namespace\", app=~\"$app\"} | json | level=~\"$level\" |~ \"$search\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "labels": true,
              "tsNs": true,
              "id": true,
              "Line": false
            },
            "indexByName": {
              "Time": 0,
              "level": 1,
              "app": 2,
              "context": 3,
              "message": 4
            },
            "renameByName": {}
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Time",
                "level",
                "app",
                "context",
                "message",
                "container",
                "pod",
                "reqId",
                "req_method",
                "req_url",
                "res_statusCode",
                "responseTime"
              ]
            }
          }
        }
      ],
      "title": "Logs (table)",
      "type": "table"
