      "targets": [
        {
          "query": "base = from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"stocdup_http_requests\" and r._field == \"value\")\n  |> filter(fn: (r) => r.environment =~ /^(${environment:regex})$/)\n  |> filter(fn: (r) => r.service =~ /^(${service:regex})$/)\ntotal = base |> group() |> sum() |> map(fn: (r) => ({ _time: now(), kind: \"total\", _value: r._value }))\nerrs = base |> filter(fn: (r) => r.status_class == \"5xx\") |> group() |> sum() |> map(fn: (r) => ({ _time: now(), kind: \"errs\", _value: r._value }))\nunion(tables: [total, errs])\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"kind\"], valueColumn: \"_value\")\n  |> map(fn: (r) => {\n      t = if exists r.total then float(v: r.total) else 0.0\n      e = if exists r.errs then float(v: r.errs) else 0.0\n      return { _time: r._time, _value: if t > 0.0 then e / t * 100.0 else 0.0 }\n  })",
          "refId": "A"
        }
      ],
      "title": "5xx % (range)",
      "type": "stat"
