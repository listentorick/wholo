<mjml>
<!--
  Sent to an invitation's address once another login has accepted it with a
  code (ADR-081), for both portal and staff invitations. It says who joined, so a person reading
  that mailbox notices if someone they don't know used the invitation, and
  tells them who to contact. Same family as staff-invite.mjml.
-->
<mj-head>
  <mj-title>{{acceptorName}} joined {{businessName}} on Stocdup</mj-title>
  <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  <mj-attributes>
    <mj-all font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    <mj-text font-size="14px" font-weight="400" line-height="1.5" color="#0B1D3A" padding="0" />
  </mj-attributes>
</mj-head>
<mj-body background-color="#F2F4F7" width="480px">

  {{> header}}

  <mj-section background-color="#E6EEFF" padding="32px 32px 32px" border-left="1px solid #E6ECF2" border-right="1px solid #E6ECF2">
    <mj-column>
      <mj-text font-size="24px" font-weight="600" line-height="1.3" color="#0B1D3A" padding-bottom="16px">
        Invitation accepted
      </mj-text>
      <mj-text color="#0B1D3A" padding-bottom="0">
        <strong>{{acceptorName}}</strong> ({{acceptorEmail}}) accepted the invitation sent to <strong>{{invitedEmail}}</strong> and joined <strong>{{businessName}}</strong> on Stocdup{{distributorClause}}.
      </mj-text>
    </mj-column>
  </mj-section>

  <mj-section background-color="#FFFFFF" padding="24px 32px 0" border-left="1px solid #E6ECF2" border-right="1px solid #E6ECF2">
    <mj-column>
      <mj-text color="#5B6B7F" padding-bottom="0">
        Not expected? Contact {{contactName}}{{contactLine}} straight away.
      </mj-text>
    </mj-column>
  </mj-section>

  {{> footer}}

</mj-body>
</mjml>
