<mjml>
<!--
  IMPECCABLE DIRECTION CONTRACT
  THESIS: same neutral (not alarm-red) treatment as
  order-delivery-failed-customer.mjml, for the same reason — a routine
  operational exception, not an incident. White band, matching
  trade-relationship-request-declined.mjml's precedent for negative-but-
  routine status emails in this system.
  OWN-WORLD: apps/portal/DESIGN.md, inherited exactly — same header/
  distributor-footer chrome, hard 0px corners, Cobalt reserved for the CTA.
  No identity-row: same reasoning as order-placed-distributor.mjml/
  order-delivered-distributor.mjml, the recipient IS the distributor.
  STORY: distributor ops staff see immediately which order failed to
  deliver and why, so they can decide whether to redeliver or follow up.
  FIRST VIEWPORT: header, one white hero — "Delivery unsuccessful"
  headline, customer+order-number sentence, reason line, "View order" —
  then distributor-footer.
  FORM: extends the established world onto the same Operate-mode audience
  as order-placed-distributor.mjml/order-delivered-distributor.mjml.
  FINISH: verified via a real MJML render/screenshot + a real MailHog send.
-->
<mj-head>
  <mj-title>Order {{orderNumber}} could not be delivered</mj-title>
  <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  <mj-attributes>
    <mj-text font-size="14px" font-weight="400" line-height="1.5" color="#0B1D3A" padding="0" />
  </mj-attributes>
</mj-head>
<mj-body background-color="#F2F4F7" width="480px">

  {{> header}}

  <mj-section background-color="#FFFFFF" padding="32px 32px 32px" border-left="1px solid #E6ECF2" border-right="1px solid #E6ECF2">
    <mj-column>
      <mj-text font-size="24px" font-weight="600" line-height="1.3" color="#0B1D3A" padding-bottom="16px">
        Delivery unsuccessful
      </mj-text>
      <mj-text color="#0B1D3A" padding-bottom="8px">
        Order <strong>{{orderNumber}}</strong> for <strong>{{customerName}}</strong> could not be delivered.
      </mj-text>
      {{#if reasonLine}}
      <mj-text color="#5B6B7F" padding-bottom="20px">
        {{reasonLine}}
      </mj-text>
      {{/if}}
      <mj-button href="{{orderUrl}}" background-color="#1565FF" color="#FFFFFF" font-size="15px"
        font-weight="600" border-radius="0" padding="0" inner-padding="14px 32px" align="center">
        View order
      </mj-button>
    </mj-column>
  </mj-section>

  {{> distributor-footer}}

</mj-body>
</mjml>
