<!-- Shared header partial: icon-only Stocdup mark + real live text, not a
     wordmark baked into an image — mirrors the admin app's own chrome lockup
     (apps/admin/src/components/Sidebar.tsx), sized up (40px icon/20px text)
     to read as a standalone header moment rather than compact in-app chrome.
     Extracted from invite.mjml v4 — every email shares this exact chrome, so
     it lives once here rather than being re-derived per template. Needs only
     {{stocdupIconUrl}}. Symmetric 32px top/bottom padding so the lockup sits
     centered in its own white zone before the next section's color starts. -->
<mj-section background-color="#FFFFFF" padding="32px 32px 32px" border="1px solid #E6ECF2" border-bottom="none">
  <mj-column>
    <mj-text align="center" padding-bottom="0">
      <img src="{{stocdupIconUrl}}" alt="" width="40" height="40" style="width:40px;height:40px;display:inline-block;vertical-align:middle;margin-right:12px;" /><span style="font-size:20px;font-weight:700;letter-spacing:-0.01em;line-height:1;vertical-align:middle;"><span style="color:#0B1D3A;">stocd</span><span style="color:#1565FF;">up</span></span>
    </mj-text>
  </mj-column>
</mj-section>
