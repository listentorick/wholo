<mjml>
<!--
  IMPECCABLE DIRECTION CONTRACT
  THESIS: same shape as order-confirmed.mjml (this pair is deliberately
  built side by side) — Cobalt-light band, the settled/positive treatment,
  reused verbatim rather than inventing a fourth status color for what is
  the same "good news, here's your reference number" story one step later
  in the order lifecycle.
  OWN-WORLD: apps/portal/DESIGN.md, inherited from order-confirmed.mjml —
  same header/footer chrome, identity-row technique, hairline card frame.
  STORY: a customer whose order was accepted now knows it has actually
  arrived — order number to reference, optional link to view it.
  FIRST VIEWPORT: header, one blue band — headline, distributor identity +
  delivered sentence, order number, optional "View order" CTA — then footer.
  FORM: extends the established world; direction was already set by
  order-confirmed.mjml.
  FINISH: verified via a real MJML render/screenshot + a real MailHog send.
-->
<mj-head>
  <mj-title>Your order with {{distributorName}} has been delivered</mj-title>
  <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  <mj-attributes>
    <mj-text font-size="14px" font-weight="400" line-height="1.5" color="#0B1D3A" padding="0" />
  </mj-attributes>
  <mj-style>
    @media only screen and (max-width:480px) {
      .distributor-byline-logo {
        width: 44px !important;
        height: 44px !important;
        border-radius: 23px !important;
      }
    }
  </mj-style>
</mj-head>
<mj-body background-color="#F2F4F7" width="480px">

  {{> header}}

  <mj-section background-color="#E6EEFF" padding="32px 32px 32px" border-left="1px solid #E6ECF2" border-right="1px solid #E6ECF2">
    <mj-column>
      <mj-text font-size="24px" font-weight="600" line-height="1.3" color="#0B1D3A" padding-bottom="16px">
        Order delivered
      </mj-text>
      {{> identity-row}}
      <mj-text color="#5B6B7F" padding-bottom="24px">
        Order number <strong style="color:#0B1D3A;">{{orderNumber}}</strong>.
      </mj-text>
      {{#if orderUrl}}
      <mj-button href="{{orderUrl}}" background-color="#1565FF" color="#FFFFFF" font-size="15px"
        font-weight="600" border-radius="0" padding="0" inner-padding="14px 32px" align="center">
        View order
      </mj-button>
      {{/if}}
    </mj-column>
  </mj-section>

  {{> footer}}

</mj-body>
</mjml>
