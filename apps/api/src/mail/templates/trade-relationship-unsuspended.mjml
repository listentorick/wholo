<mjml>
<!--
  IMPECCABLE DIRECTION CONTRACT
  THESIS: the positive mirror of suspended.mjml — same identity+sentence
  shape, Cobalt-light instead of Light Blue Grey, because the wait is over
  and there's something to do again. Lighter-weight than
  trade-relationship-request-accepted.mjml on purpose: that email is a
  first-touch moment and earns the benefits checklist; this customer already
  knows the platform, they just got their access back, so headline +
  sentence + CTA is the whole story — adding a checklist here would be
  filler, not information.
  OWN-WORLD: apps/portal/DESIGN.md, inherited from invite.mjml — same
  header/footer chrome, same cobalt-light band, same floated-identity
  technique.
  STORY: a customer whose account was suspended sees plainly that it isn't
  anymore, and can go straight back to ordering.
  FIRST VIEWPORT: header, one blue band — headline, identity + the
  reactivation sentence, CTA — then straight to the footer.
  FORM: extends the established world; direction was already set.
  FINISH: verified via a real MJML render/screenshot + a real MailHog send.
-->
<mj-head>
  <mj-title>{{distributorName}} reactivated your account</mj-title>
  <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  <mj-attributes>
    <mj-text font-size="14px" font-weight="400" line-height="1.5" color="#0B1D3A" padding="0" />
  </mj-attributes>
  <mj-style>
    @media only screen and (max-width:480px) {
      .distributor-byline-logo {
        width: 44px !important;
        height: 44px !important;
        border-radius: 23px !important;
      }
    }
  </mj-style>
</mj-head>
<mj-body background-color="#F2F4F7" width="480px">

  {{> header}}

  <!-- Section's own fixed bottom padding, same fix as the order emails —
       the CTA here is conditional too. -->
  <mj-section background-color="#E6EEFF" padding="32px 32px 32px" border-left="1px solid #E6ECF2" border-right="1px solid #E6ECF2">
    <mj-column>
      <mj-text font-size="24px" font-weight="600" line-height="1.3" color="#0B1D3A" padding-bottom="16px">
        Account reactivated
      </mj-text>
      {{> identity-row}}
      {{#if portalUrl}}
      <mj-button href="{{portalUrl}}" background-color="#1565FF" color="#FFFFFF" font-size="15px"
        font-weight="600" border-radius="0" padding="0" inner-padding="14px 32px" align="center">
        View catalogue
      </mj-button>
      {{/if}}
    </mj-column>
  </mj-section>

  {{> footer}}

</mj-body>
</mjml>
