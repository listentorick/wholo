<mjml>
<!--
  Staff (employee) invitation. Same world as invite.mjml — apps/portal
  DESIGN.md: Deep Navy / Cobalt (the single CTA) / Slate Blue, Inter, hard 0px
  corners — built on the shared header/footer partials so it reads as one
  family of emails. The hero band carries the headline, the one factual
  sentence and the CTA; the white section below states the two things the
  invitee must know: the invitation only works for the address it was sent
  to, and when it expires. A plain-text fallback link follows because the
  link IS the credential and some clients block buttons.
-->
<mj-head>
  <mj-title>{{inviterName}} invited you to join {{distributorName}} on Stocdup</mj-title>
  <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  <mj-attributes>
    <mj-all font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    <mj-text font-size="14px" font-weight="400" line-height="1.5" color="#0B1D3A" padding="0" />
  </mj-attributes>
</mj-head>
<mj-body background-color="#F2F4F7" width="480px">

  {{> header}}

  <mj-section background-color="#E6EEFF" padding="32px 32px 0" border-left="1px solid #E6ECF2" border-right="1px solid #E6ECF2">
    <mj-column>
      <mj-text font-size="24px" font-weight="600" line-height="1.3" color="#0B1D3A" padding-bottom="16px">
        {{inviterName}} invited you to join {{distributorName}}
      </mj-text>
      <mj-text color="#0B1D3A" padding-bottom="24px">
        <strong>{{inviterName}}</strong> has invited you to work with <strong>{{distributorName}}</strong> on <strong>Stocdup</strong> as <strong>{{rolesText}}</strong>.
      </mj-text>
      <mj-button href="{{inviteUrl}}" background-color="#1565FF" color="#FFFFFF" font-size="15px"
        font-weight="600" border-radius="0" padding="0 0 32px" inner-padding="14px 32px" align="center">
        Accept invitation
      </mj-button>
    </mj-column>
  </mj-section>

  <mj-section background-color="#FFFFFF" padding="24px 32px 0" border-left="1px solid #E6ECF2" border-right="1px solid #E6ECF2">
    <mj-column>
      <mj-text color="#5B6B7F" padding-bottom="16px">
        Create your Stocdup account with <strong style="color:#0B1D3A;">{{recipientEmail}}</strong> &mdash; this invitation only works for that address &mdash; and verify it when asked. The invitation expires on {{expiresAtFormatted}}.
      </mj-text>
      <mj-text font-size="12px" font-weight="500" letter-spacing="0.02em" color="#5B6B7F" padding-bottom="16px">
        Button not working? Paste this link into your browser:<br /><span style="color:#1565FF;word-break:break-all;">{{inviteUrl}}</span>
      </mj-text>
      <mj-text font-size="12px" font-weight="500" letter-spacing="0.02em" color="#5B6B7F" padding-bottom="0">
        Wasn&rsquo;t expecting this? You can ignore this email &mdash; nothing happens unless you accept.
      </mj-text>
    </mj-column>
  </mj-section>

  {{> footer}}

</mj-body>
</mjml>
