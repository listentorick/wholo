<mjml>
<!--
  IMPECCABLE DIRECTION CONTRACT
  THESIS: same shape as order-received.mjml (this pair is deliberately built
  side by side, same information architecture) but Cobalt-light instead of
  Amber — the wait is over, this is the settled/positive state. Band color
  alone tells the two statuses apart if both ever land in the same inbox
  thread; copy doesn't have to do all the work.
  OWN-WORLD: apps/portal/DESIGN.md, inherited from invite.mjml — same
  header/footer chrome (partials/_header.mjml, _footer.mjml), same flat
  hairline card frame, same floated-circle distributor-identity technique.
  STORY: a customer whose order was pending now knows it's accepted, has the
  order number to reference, and can go look at it if they want to.
  FIRST VIEWPORT: header, then one blue band — headline, distributor
  identity + confirmation sentence, order number, a "View order" CTA
  (omitted gracefully with no portal link) — then the footer. No second
  content section, same reasoning as order-received: nothing else to say.
  FORM: extends the established world; direction was already set.
  FINISH: verified via a real MJML render/screenshot + a real MailHog send.
-->
<mj-head>
  <mj-title>Your order with {{distributorName}} has been confirmed</mj-title>
  <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  <mj-attributes>
    <mj-text font-size="14px" font-weight="400" line-height="1.5" color="#0B1D3A" padding="0" />
  </mj-attributes>
  <mj-style>
    @media only screen and (max-width:480px) {
      .distributor-byline-logo {
        width: 44px !important;
        height: 44px !important;
        border-radius: 23px !important;
      }
    }
  </mj-style>
</mj-head>
<mj-body background-color="#F2F4F7" width="480px">

  {{> header}}

  <!-- Section's own fixed bottom padding (32px) rather than the last
       element's, same fix as order-received.mjml — the CTA is conditional. -->
  <mj-section background-color="#E6EEFF" padding="32px 32px 32px" border-left="1px solid #E6ECF2" border-right="1px solid #E6ECF2">
    <mj-column>
      <mj-text font-size="24px" font-weight="600" line-height="1.3" color="#0B1D3A" padding-bottom="16px">
        Order confirmed
      </mj-text>
      {{> identity-row}}
      <mj-text color="#5B6B7F" padding-bottom="24px">
        Order number <strong style="color:#0B1D3A;">{{orderNumber}}</strong>.
      </mj-text>
      {{#if orderUrl}}
      <mj-button href="{{orderUrl}}" background-color="#1565FF" color="#FFFFFF" font-size="15px"
        font-weight="600" border-radius="0" padding="0" inner-padding="14px 32px" align="center">
        View order
      </mj-button>
      {{/if}}
    </mj-column>
  </mj-section>

  {{> footer}}

</mj-body>
</mjml>
