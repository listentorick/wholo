<mjml>
<!--
  The one layout behind every email Keycloak sends (verify email, password
  reset, security notices...). Not sent by apps/api: keycloak-email.ts
  compiles it once per entry in its KEYCLOAK_EMAILS list and the output is
  committed into Keycloak's email theme (apps/keycloak/themes/wholo/email).
  Built from the same header and support-footer partials as our own emails so
  the two cannot drift apart; the structure follows accounting-reconnect.mjml
  (headline, copy and the single Cobalt CTA together on one tinted band).
  The band uses the invite email's pale blue (E6EEFF): these are account
  emails from Stocdup itself, not a distributor's status update.
  Every slot below is optional except the body, so one layout covers an
  action email (headline, copy, button, expiry note), a plain notice
  (headline, copy, note) and the bare wrapper for emails Keycloak adds later.
-->
<mj-head>
  <mj-title>{{title}}</mj-title>
  <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  <mj-attributes>
    <mj-all font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    <mj-text font-size="14px" font-weight="400" line-height="1.5" color="#0B1D3A" padding="0" />
  </mj-attributes>
</mj-head>
<mj-body background-color="#F2F4F7" width="480px">

  {{> header}}

  <mj-section background-color="#E6EEFF" padding="32px 32px 32px" border-left="1px solid #E6ECF2" border-right="1px solid #E6ECF2">
    <mj-column>
      {{#if headline}}
      <mj-text font-size="24px" font-weight="600" line-height="1.3" color="#0B1D3A" padding-bottom="16px">
        {{headline}}
      </mj-text>
      {{/if}}
      <mj-text color="#0B1D3A" padding-bottom="{{bodyGap}}px">
        {{body}}
      </mj-text>
      {{#if buttonLabel}}
      <mj-button href="{{link}}" background-color="#1565FF" color="#FFFFFF" font-size="15px"
        font-weight="600" border-radius="0" padding="0" inner-padding="14px 32px" align="center">
        {{buttonLabel}}
      </mj-button>
      {{/if}}
    </mj-column>
  </mj-section>

  {{#if note}}
  <mj-section background-color="#FFFFFF" padding="24px 32px 0" border-left="1px solid #E6ECF2" border-right="1px solid #E6ECF2">
    <mj-column>
      <mj-text align="center" font-size="12px" font-weight="500" letter-spacing="0.02em" color="#5B6B7F" padding-bottom="0">
        {{note}}
      </mj-text>
    </mj-column>
  </mj-section>
  {{/if}}

  {{> distributor-footer}}

</mj-body>
</mjml>
