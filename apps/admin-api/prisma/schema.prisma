generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, timescaledb]
}

enum OrganisationType {
  DISTRIBUTOR
  TRADE_CUSTOMER
}

enum Role {
  PLATFORM_ADMIN
  DISTRIBUTOR_ADMIN
  OPERATIONS_MANAGER
  WAREHOUSE_STAFF
  DRIVER
  TRADE_CUSTOMER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TaxClassification {
  STANDARD
  REDUCED
  ZERO_RATED
  EXEMPT
  OUTSIDE_SCOPE
}

enum TradeRelationshipStatus {
  PENDING_INVITE
  PENDING_REQUEST
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// Cart backing data — temporary, cleared on submission
enum CartOrderStatus {
  DRAFT
}

// Commercial order statuses
enum OrderStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
  DELIVERED
  DELIVERY_FAILED
}

enum OrderLineStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum OrderAcceptanceMode {
  MANUAL
  AUTO_ON_SUBMISSION
}

enum AcceptanceModeSource {
  DISTRIBUTOR_DEFAULT
  TRADER_CUSTOMER_OVERRIDE
}

// How an order's invoice due date is worked out (ADR-075). Calendar maths
// runs from the invoice date (= acceptance date in the distributor's
// timezone). ACCOUNTING_SYSTEM_DEFAULT deliberately computes nothing: no due
// date is sent and the accounting system's own contact/organisation terms
// decide it.
enum PaymentTermType {
  ACCOUNTING_SYSTEM_DEFAULT
  DUE_IMMEDIATELY
  DAYS_AFTER_INVOICE
  DAYS_AFTER_MONTH_END
  DAY_OF_WEEK
  DAY_OF_MONTH
}

enum PaymentTermSource {
  DISTRIBUTOR_DEFAULT
  TRADER_CUSTOMER_OVERRIDE
}

enum AcceptedByActorType {
  USER
  SYSTEM
}

// Distinct from AcceptedByActorType, which is specific to order acceptance —
// this is the generic actor kind for AuditLog, spanning any future entity.
enum ActorType {
  USER
  SYSTEM
}

enum OutboxEventStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum NotificationType {
  ORDER_PLACED
  CUSTOMER_INVITE_SENT
  STAFF_INVITE_SENT
  TRADE_RELATIONSHIP_REQUEST_ACCEPTED
  TRADE_RELATIONSHIP_REQUEST_DECLINED
  TRADE_RELATIONSHIP_SUSPENDED
  TRADE_RELATIONSHIP_UNSUSPENDED
  TRADE_RELATIONSHIP_ACTIVATED
  ORDER_DELIVERED
  ORDER_DELIVERY_FAILED
}

enum NotificationChannel {
  EMAIL
  WEB_PUSH
  IN_APP
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationAudience {
  DISTRIBUTOR
  CUSTOMER
}

enum PriceListRuleSelectorType {
  ALL_PRODUCTS
  PRODUCT
}

enum PriceListRuleValueType {
  FIXED_PRICE
  PERCENTAGE_DISCOUNT
}

enum PriceListRuleDiscountBaseType {
  PRODUCT_PRICE
  PRICE_LIST
}

enum AccountingProvider {
  XERO
}

enum AccountingConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  REVOKED
}

enum AccountingContactMatchStatus {
  SUGGESTED
  ACCEPTED
  REJECTED
  SUPERSEDED
}

enum AccountingContactMatchMethod {
  ACCOUNT_CODE_EXACT
  EMAIL_EXACT
  NAME_EXACT
  NAME_POSTCODE
  NAME_FUZZY
  MANUAL
}

enum AccountingProductMatchStatus {
  SUGGESTED
  ACCEPTED
  REJECTED
  SUPERSEDED
}

enum AccountingProductMatchMethod {
  SKU_EXACT
  SKU_NORMALISED
  NAME_EXACT
  NAME_FUZZY
  MANUAL
}

enum AccountingTaxTypeMatchStatus {
  SUGGESTED
  ACCEPTED
  REJECTED
  SUPERSEDED
}

enum AccountingTaxTypeMatchMethod {
  NAME_EXACT
  NAME_NORMALISED
  NAME_FUZZY
  MANUAL
}

enum AccountingInvoiceExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Status the invoice is created with in the accounting system. Provider-neutral
// vocabulary; each adapter maps it onto its own status model (Xero: Draft /
// Submitted for approval / Authorised).
enum AccountingInvoiceTargetStatus {
  DRAFT
  SUBMITTED
  AUTHORISED
}

// Lifecycle of an invoice in the accounting system, as last synced back
// (provider-neutral; each adapter maps its own vocabulary onto it — Xero:
// DRAFT / SUBMITTED / AUTHORISED / PAID / VOIDED / DELETED).
enum AccountingInvoiceState {
  DRAFT
  AWAITING_APPROVAL
  AWAITING_PAYMENT
  PAID
  VOIDED
  DELETED
}

enum AccountingBulkImportRecordType {
  PRODUCT
  CONTACT
}

enum AccountingBulkImportJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum IngestionRunStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum IngestionRunTrigger {
  MANUAL
  SCHEDULED
}

model Organisation {
  id                                String                             @id @default(cuid())
  name                              String
  slug                              String?                            @unique
  type                              OrganisationType
  email                             String?
  phone                             String?
  legalName                         String?
  addressLine1                      String?
  addressLine2                      String?
  addressCity                       String?
  addressState                      String?
  addressPostcode                   String?
  addressCountry                    String?
  billingLine1                      String?
  billingLine2                      String?
  billingCity                       String?
  billingState                      String?
  billingPostcode                   String?
  billingCountry                    String?
  createdAt                         DateTime                           @default(now())
  updatedAt                         DateTime                           @updatedAt
  deletedAt                         DateTime?
  memberships                       Membership[]
  productTypes                      ProductType[]                      @relation("DistributorProductTypes")
  suppliers                         Supplier[]                         @relation("DistributorSuppliers")
  products                          Product[]                          @relation("DistributorProducts")
  catalogues                        Catalogue[]                        @relation("DistributorCatalogues")
  tradeRelationshipsAsDistributor   TradeRelationship[]                @relation("DistributorRelationships")
  tradeRelationshipsAsCustomer      TradeRelationship[]                @relation("CustomerRelationships")
  customerInvitations               CustomerInvitation[]
  staffInvitations                  StaffInvitation[]
  cartOrdersAsDistributor           CartOrder[]                        @relation("DistributorCartOrders")
  cartOrdersAsCustomer              CartOrder[]                        @relation("CustomerCartOrders")
  ordersAsDistributor               Order[]                            @relation("DistributorOrders")
  ordersAsCustomer                  Order[]                            @relation("CustomerOrders")
  distributorSettings               DistributorSettings?
  priceLists                        PriceList[]                        @relation("DistributorPriceLists")
  taxTypes                          TaxType[]                          @relation("DistributorTaxTypes")
  paymentTerms                      PaymentTerm[]                      @relation("DistributorPaymentTerms")
  deliveryProfiles                  DeliveryProfile[]                  @relation("DistributorDeliveryProfiles")
  deliveryRoutes                    DeliveryRoute[]                    @relation("DistributorDeliveryRoutes")
  deliveryRuns                      DeliveryRun[]                      @relation("DistributorDeliveryRuns")
  deliveryRouteCustomerAssignments  DeliveryRouteCustomer[]            @relation("DeliveryRouteCustomerAssignments")
  orderAsSessionsAsDistributor      OrderAsSession[]                   @relation("OrderAsDistributor")
  orderAsSessionsAsCustomer         OrderAsSession[]                   @relation("OrderAsCustomer")
  accountingConnections             AccountingConnection[]
  accountingOrganisations           AccountingOrganisation[]
  externalAccountingContacts        ExternalAccountingContact[]
  customerAccountingMappings        CustomerAccountingMapping[]
  accountingContactMatchSuggestions AccountingContactMatchSuggestion[]
  externalAccountingProducts        ExternalAccountingProduct[]
  productAccountingMappings         ProductAccountingMapping[]
  accountingProductMatchSuggestions AccountingProductMatchSuggestion[]
  externalAccountingTaxTypes        ExternalAccountingTaxType[]
  taxTypeAccountingMappings         TaxTypeAccountingMapping[]
  accountingTaxTypeMatchSuggestions AccountingTaxTypeMatchSuggestion[]
  accountingInvoiceExports          AccountingInvoiceExport[]
  accountingBulkImportJobs          AccountingBulkImportJob[]
  ingestionRuns                     IngestionRun[]
  auditLogs                         AuditLog[]

  @@map("organisations")
}

model User {
  id                       String            @id @default(cuid())
  email                    String            @unique
  keycloakId               String?           @unique
  passwordHash             String?
  firstName                String
  lastName                 String
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  deletedAt                DateTime?
  memberships              Membership[]
  refreshTokens            RefreshToken[]
  cartOrders               CartOrder[]
  orderAsSessions          OrderAsSession[]  @relation("AdminOrderAsSessions")
  delegateOrders           Order[]           @relation("DelegateOrders")
  staffInvitationsSent     StaffInvitation[] @relation("StaffInvitationInvitedBy")
  staffInvitationsAccepted StaffInvitation[] @relation("StaffInvitationAcceptedBy")

  @@map("users")
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organisationId String
  role           Role // kept during multi-role transition; see MembershipRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id])
  organisation   Organisation     @relation(fields: [organisationId], references: [id])
  roles          MembershipRole[]

  @@unique([userId, organisationId])
  @@map("memberships")
}

model MembershipRole {
  id           String     @id @default(cuid())
  membershipId String
  role         Role
  createdAt    DateTime   @default(now())
  membership   Membership @relation(fields: [membershipId], references: [id])

  @@unique([membershipId, role])
  @@map("membership_roles")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model ProductType {
  id            String       @id @default(cuid())
  distributorId String
  name          String
  code          String
  displayOrder  Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  distributor   Organisation @relation("DistributorProductTypes", fields: [distributorId], references: [id])
  products      Product[]

  @@unique([distributorId, code])
  @@index([distributorId])
  @@map("product_types")
}

model Supplier {
  id            String       @id @default(cuid())
  distributorId String
  name          String
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  distributor   Organisation @relation("DistributorSuppliers", fields: [distributorId], references: [id])
  products      Product[]

  @@index([distributorId])
  @@map("suppliers")
}

model Product {
  id                         String                             @id @default(cuid())
  distributorId              String
  productTypeId              String?
  supplierId                 String?
  name                       String
  description                String?
  sku                        String?
  status                     ProductStatus                      @default(DRAFT)
  price                      Decimal?                           @db.Decimal(10, 2)
  taxTypeId                  String?
  deletedAt                  DateTime?
  createdAt                  DateTime                           @default(now())
  updatedAt                  DateTime                           @updatedAt
  distributor                Organisation                       @relation("DistributorProducts", fields: [distributorId], references: [id])
  productType                ProductType?                       @relation(fields: [productTypeId], references: [id])
  supplier                   Supplier?                          @relation(fields: [supplierId], references: [id])
  taxType                    TaxType?                           @relation(fields: [taxTypeId], references: [id])
  externalReferences         ProductExternalReference[]
  cartOrderLines             CartOrderLine[]
  orderLines                 OrderLine[]
  catalogues                 CatalogueProduct[]
  priceListRules             PriceListRule[]                    @relation("ProductPriceListRules")
  searchDocument             ProductSearchDocument?
  accountingMappings         ProductAccountingMapping[]
  accountingMatchSuggestions AccountingProductMatchSuggestion[]

  @@unique([distributorId, sku])
  @@index([distributorId, createdAt])
  @@index([distributorId, deletedAt])
  @@map("products")
}

// Curated search document per product (see ADR-050). App code maintains the
// text fields; searchVector is a Postgres generated column derived from
// searchText (added in the migration — Prisma cannot express generated columns).
model ProductSearchDocument {
  productId            String                   @id
  distributorId        String
  searchText           String
  searchTextNormalised String
  nameNormalised       String
  skuNormalised        String?
  searchVector         Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, \"searchText\")"))
  updatedAt            DateTime                 @updatedAt
  product              Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([distributorId])
  @@index([searchVector], type: Gin)
  @@index([searchTextNormalised(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([nameNormalised(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([skuNormalised(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("product_search_documents")
}

// Superseded for accounting by ProductAccountingMapping (connection-scoped,
// soft-unlink, matchMethod audit trail). Kept for a future non-accounting
// external-id use case; nothing reads or writes it today.
model ProductExternalReference {
  id            String   @id @default(cuid())
  productId     String
  distributorId String
  source        String
  externalId    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id])

  @@unique([productId, source])
  @@index([distributorId, source])
  @@map("product_external_references")
}

// unique_active_account_number (see ADR-052): activeAccountNumber mirrors
// accountNumber only while deletedAt is null, and is null otherwise, so a
// soft-deleted customer's account number can be reused by a live one.
// Maintained automatically by the trade_relationships_set_marker trigger
// (see the add_active_marker_triggers migration) — not application code.
model TradeRelationship {
  id                         String                             @id @default(cuid())
  distributorId              String
  customerId                 String
  status                     TradeRelationshipStatus            @default(PENDING_INVITE)
  accountNumber              String?
  activeAccountNumber        String?
  creditLimit                Decimal?                           @db.Decimal(10, 2)
  minimumOrderSpend          Decimal?                           @db.Decimal(10, 2)
  notes                      String?
  recentContactSelfDeclared  Boolean?
  deliveryLine1              String?
  deliveryLine2              String?
  deliveryCity               String?
  deliveryState              String?
  deliveryPostcode           String?
  deliveryCountry            String?
  deletedAt                  DateTime?
  createdAt                  DateTime                           @default(now())
  updatedAt                  DateTime                           @updatedAt
  distributor                Organisation                       @relation("DistributorRelationships", fields: [distributorId], references: [id])
  customer                   Organisation                       @relation("CustomerRelationships", fields: [customerId], references: [id])
  invitations                CustomerInvitation[]
  catalogues                 CustomerCatalogue[]
  traderCustomerSettings     TraderCustomerSettings?
  orderAsSessions            OrderAsSession[]
  accountingMappings         CustomerAccountingMapping[]
  accountingMatchSuggestions AccountingContactMatchSuggestion[]

  @@unique([distributorId, customerId])
  @@unique([distributorId, activeAccountNumber])
  @@index([distributorId, createdAt])
  @@index([distributorId, status])
  @@index([customerId, status])
  @@map("trade_relationships")
}

model CustomerInvitation {
  id                  String            @id @default(cuid())
  tradeRelationshipId String
  distributorId       String
  email               String
  token               String            @unique
  status              InvitationStatus  @default(PENDING)
  expiresAt           DateTime
  acceptedAt          DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  tradeRelationship   TradeRelationship @relation(fields: [tradeRelationshipId], references: [id])
  distributor         Organisation      @relation(fields: [distributorId], references: [id])

  @@index([token])
  @@index([distributorId])
  @@map("customer_invitations")
}

// A distributor Owner's invitation for an employee to join their DISTRIBUTOR
// organisation (ADR-067). Sibling of CustomerInvitation — that model requires a
// tradeRelationshipId, which does not apply to staff. The raw token only ever
// appears in the emailed link; we store its sha256. Acceptance copies `roles`
// onto the new Membership.
model StaffInvitation {
  id               String           @id @default(cuid())
  distributorId    String
  email            String
  roles            Role[]
  tokenHash        String           @unique
  status           InvitationStatus @default(PENDING)
  expiresAt        DateTime
  invitedByUserId  String
  acceptedByUserId String?
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  distributor      Organisation     @relation(fields: [distributorId], references: [id])
  invitedBy        User             @relation("StaffInvitationInvitedBy", fields: [invitedByUserId], references: [id])
  acceptedBy       User?            @relation("StaffInvitationAcceptedBy", fields: [acceptedByUserId], references: [id])

  @@index([distributorId, status])
  @@map("staff_invitations")
}

// ─── Cart backing data ────────────────────────────────────────────────────────

model CartOrder {
  id            String          @id @default(cuid())
  distributorId String
  customerId    String
  userId        String
  status        CartOrderStatus @default(DRAFT)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  distributor   Organisation    @relation("DistributorCartOrders", fields: [distributorId], references: [id])
  customer      Organisation    @relation("CustomerCartOrders", fields: [customerId], references: [id])
  user          User            @relation(fields: [userId], references: [id])
  lines         CartOrderLine[]

  @@unique([distributorId, customerId, userId, status])
  @@index([distributorId, status])
  @@index([customerId, status])
  @@map("cart_orders")
}

model CartOrderLine {
  id                      String    @id @default(cuid())
  orderId                 String
  productId               String
  quantity                Int
  unitPrice               Decimal   @db.Decimal(10, 2)
  resolvedPriceListId     String?
  resolvedPriceListRuleId String?
  priceResolvedAt         DateTime?
  // Resolved once, at cart-add time, frozen like unitPrice above (never
  // re-resolved) — same rationale as ADR-036's price stability during
  // checkout, since tax rates do change and a cart's total shouldn't drift
  // silently while a customer is still shopping.
  taxTypeId               String?
  taxRateSnapshot         Decimal?  @db.Decimal(5, 2)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  order                   CartOrder @relation(fields: [orderId], references: [id])
  product                 Product   @relation(fields: [productId], references: [id])
  taxType                 TaxType?  @relation(fields: [taxTypeId], references: [id])

  @@unique([orderId, productId])
  @@map("cart_order_lines")
}

// ─── Commercial orders ────────────────────────────────────────────────────────

model Order {
  id               String @id @default(cuid())
  distributorId    String
  traderCustomerId String
  placedByUserId   String
  orderNumber      String @unique

  status           OrderStatus
  fulfilmentStatus String?
  invoiceStatus    String?
  paymentStatus    String?

  acceptanceModeSnapshot       OrderAcceptanceMode
  acceptanceModeSourceSnapshot AcceptanceModeSource

  // Payment terms resolved and frozen at acceptance (ADR-075) — null until
  // the order is accepted. dueDate stays null when the term defers to the
  // accounting system. paymentTermSnapshot is the term's rule as it stood
  // (name/type/days/dayOfWeek/dayOfMonth), so later edits never rewrite it.
  invoiceDate               DateTime?          @db.Date
  dueDate                   DateTime?          @db.Date
  paymentTermIdSnapshot     String?
  paymentTermSnapshot       Json?
  paymentTermSourceSnapshot PaymentTermSource?

  currency       String  @default("GBP")
  subtotalAmount Decimal @db.Decimal(10, 2)
  taxAmount      Decimal @db.Decimal(10, 2)
  totalAmount    Decimal @db.Decimal(10, 2)

  billingAddressSnapshot  Json?
  deliveryAddressSnapshot Json?
  requestedDeliveryDate   DateTime? @db.Date
  // Distributor's current committed delivery date — set from
  // requestedDeliveryDate on first native-delivery-planning allocation
  // (DeliveryRunAllocationProcessor), independently mutable afterwards via
  // the change-delivery-date action. requestedDeliveryDate is never touched
  // again once set, for audit/customer-service visibility.
  scheduledDeliveryDate   DateTime? @db.Date
  customerReference       String?
  notes                   String?

  submittedAt         DateTime?
  acceptedAt          DateTime?
  acceptedByActorType AcceptedByActorType?
  acceptedByUserId    String?
  rejectedAt          DateTime?
  rejectedByUserId    String?
  rejectionReason     String?
  cancelledAt         DateTime?
  cancelledByUserId   String?
  cancellationReason  String?

  isOrderedByDelegate Boolean @default(false)
  delegateAdminUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  distributor       Organisation              @relation("DistributorOrders", fields: [distributorId], references: [id])
  customer          Organisation              @relation("CustomerOrders", fields: [traderCustomerId], references: [id])
  delegateAdmin     User?                     @relation("DelegateOrders", fields: [delegateAdminUserId], references: [id])
  lines             OrderLine[]
  notifications     Notification[]
  invoiceExports    AccountingInvoiceExport[]
  deliveryRunOrders DeliveryRunOrder[]
  deliveryOutcome   OrderDeliveryOutcome?
  deliveryPhotos    OrderDeliveryPhoto[]

  @@index([distributorId, status])
  @@index([traderCustomerId, status])
  @@index([distributorId, createdAt])
  @@map("orders")
}

model OrderLine {
  id               String @id @default(cuid())
  orderId          String
  distributorId    String
  traderCustomerId String
  productId        String

  productVariantId      String?
  skuSnapshot           String?
  productNameSnapshot   String
  unitOfMeasureSnapshot String?

  quantityOrdered           Int
  unitPriceSnapshot         Decimal            @db.Decimal(10, 2)
  subtotalAmount            Decimal            @db.Decimal(10, 2)
  taxAmount                 Decimal            @db.Decimal(10, 2)
  totalAmount               Decimal            @db.Decimal(10, 2)
  priceListIdSnapshot       String?
  priceListRuleIdSnapshot   String?
  // Frozen at order placement (never touched again — AC7): rate is carried
  // from the cart's own frozen taxRateSnapshot; name/classification are
  // joined from TaxType at that one moment. taxTypeId is a bare pointer for
  // reporting, same un-related style as priceListIdSnapshot above.
  taxTypeId                 String?
  taxTypeNameSnapshot       String?
  taxClassificationSnapshot TaxClassification?
  taxRatePercentageSnapshot Decimal?           @db.Decimal(5, 2)

  status    OrderLineStatus
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([distributorId])
  @@map("order_lines")
}

// ─── Analytics fact layer (wholesaler homepage dashboard) ─────────────────────
// order_facts / order_line_facts are TimescaleDB hypertables (converted via
// SELECT create_hypertable(...) hand-appended to the generated migration —
// Prisma's schema DSL cannot express this, same precedent as the partial
// unique indexes on the accounting mapping tables). Append-only, immutable —
// never UPDATE or DELETE a row. Timescale requires every unique index
// (including the primary key) on a hypertable to include the partitioning
// column, hence the composite @@id ending in occurredAt rather than a
// separate cuid — that composite is also the ADR-047 "inbox" idempotency key
// (a replayed event hits the PK conflict and is a no-op).
//
// order_analytics_state is a plain (non-hypertable) table: one row per order,
// always reflecting current truth, upserted with an out-of-order guard
// (only accept an incoming event if it's newer than the last one applied).
// This is what Phase 1's dashboard endpoints query directly — no separate
// daily-aggregate/continuous-aggregate layer, since aggregating this compact
// one-row-per-order table at query time is both correct-by-construction
// (a cancellation just updates its one row) and fast enough at Wholo's scale.
model OrderFact {
  eventId              String
  distributorId        String
  orderId              String
  traderCustomerId     String
  eventType            String // OrderSubmitted | OrderAccepted | OrderRejected | OrderCancelled | OrderDelivered | OrderDeliveryFailed
  resultingStatus      OrderStatus
  subtotalAmount       Decimal     @db.Decimal(10, 2)
  isOrderedByDelegate  Boolean     @default(false) // placed by distributor staff on the customer's behalf, not by the customer
  occurredAt           DateTime // UTC business timestamp; hypertable partitioning column
  distributorLocalDate DateTime    @db.Date // computed at write time from the distributor's timezone as of this event
  recordedAt           DateTime    @default(now())

  @@id([eventId, occurredAt])
  @@index([distributorId, distributorLocalDate])
  @@index([orderId])
  @@index([occurredAt]) // matches the index TimescaleDB's create_hypertable() auto-creates on the partitioning column
  @@map("order_facts")
}

model OrderLineFact {
  eventId              String
  orderLineId          String
  distributorId        String
  orderId              String
  productId            String
  traderCustomerId     String
  quantity             Int
  netValue             Decimal  @db.Decimal(10, 2)
  occurredAt           DateTime
  distributorLocalDate DateTime @db.Date
  recordedAt           DateTime @default(now())

  @@id([eventId, orderLineId, occurredAt])
  @@index([distributorId, distributorLocalDate])
  @@index([productId])
  @@index([occurredAt]) // matches the index TimescaleDB's create_hypertable() auto-creates on the partitioning column
  @@map("order_line_facts")
}

model OrderAnalyticsState {
  orderId              String      @id
  distributorId        String
  traderCustomerId     String
  status               OrderStatus
  subtotalAmount       Decimal     @db.Decimal(10, 2)
  isOrderedByDelegate  Boolean     @default(false)
  distributorLocalDate DateTime    @db.Date
  lastEventAt          DateTime
  updatedAt            DateTime    @updatedAt

  @@index([distributorId, distributorLocalDate, status])
  @@index([distributorId, traderCustomerId, status])
  // Serves the missed-order rule: each customer's most recent order dates, newest first, read straight off the index.
  @@index([distributorId, traderCustomerId, distributorLocalDate(sort: Desc)])
  @@map("order_analytics_state")
}

// Append-only log of delivery outcomes (OrderDelivered / OrderDeliveryFailed),
// the substrate for delivery trends (on-time, failures and why, by route).
// Records what was observed; "late" / "on time" are derived on read from
// committedDate vs distributorLocalDate so the definition can change without a
// rewrite. Like order_facts it has no foreign keys (a fact outlives whatever it
// describes) and is a Timescale hypertable on occurredAt — see ADR-052 for why
// the matching @@index([occurredAt]) is declared.
model DeliveryFact {
  eventId              String
  distributorId        String
  orderId              String
  traderCustomerId     String
  outcome              DeliveryOutcomeType
  unableReason         UnableToDeliverReason?
  dropMethod           DeliveryDropMethod?
  // The date the distributor had committed to at the moment of the outcome
  // (scheduledDeliveryDate ?? requestedDeliveryDate). Null for an undated order.
  committedDate        DateTime?              @db.Date
  requestedDate        DateTime?              @db.Date
  routeId              String?
  runId                String?
  occurredAt           DateTime // UTC business timestamp (server-recorded outcome time); hypertable partitioning column
  distributorLocalDate DateTime               @db.Date // the calendar day of the outcome in the distributor's timezone
  recordedAt           DateTime               @default(now())

  @@id([eventId, occurredAt])
  @@index([distributorId, distributorLocalDate])
  @@index([distributorId, committedDate])
  @@index([orderId])
  @@index([occurredAt])
  @@map("delivery_facts")
}

// How a trade relationship was opened (ADR-070): typed in by distributor staff,
// imported from their accounting system (existing book of business), or
// requested by the customer through discovery. UNKNOWN only when a later event
// is consumed before the opening one.
enum RelationshipOrigin {
  MANUAL
  ACCOUNTING_IMPORT
  ACCESS_REQUEST
  UNKNOWN
}

// Append-only log of trade-relationship lifecycle events (ADR-070): created,
// access requested, invite sent/accepted, request accepted/declined, activated,
// suspended/unsuspended, removed. The substrate for new-business win rate,
// activation and acquisition cohorts. Like the other fact tables it has no
// foreign keys and is a Timescale hypertable on occurredAt (see ADR-052).
model RelationshipFact {
  eventId              String
  distributorId        String
  relationshipId       String
  customerId           String
  eventType            String
  fromStatus           TradeRelationshipStatus? // null when the event opens the relationship
  toStatus             TradeRelationshipStatus
  occurredAt           DateTime // UTC business timestamp; hypertable partitioning column
  distributorLocalDate DateTime                 @db.Date
  recordedAt           DateTime                 @default(now())

  @@id([eventId, occurredAt])
  @@index([distributorId, distributorLocalDate])
  @@index([relationshipId])
  @@index([occurredAt])
  @@map("relationship_facts")
}

// One row per relationship, projected from relationship_facts: how it was
// opened, when it FIRST became active (never moved by a later suspend/unsuspend),
// and its current status. The read model for activation and win rate.
model RelationshipAnalyticsState {
  relationshipId String                  @id
  distributorId  String
  customerId     String
  origin         RelationshipOrigin
  openedAt       DateTime?
  activatedAt    DateTime?
  activatedVia   String? // the event type of the first activation
  status         TradeRelationshipStatus
  removedAt      DateTime?
  lastEventAt    DateTime
  updatedAt      DateTime                @updatedAt

  @@index([distributorId, activatedAt])
  @@index([distributorId, status])
  @@map("relationship_analytics_state")
}

// How paid an invoice is (derived — see accounting/invoice-payment-status.ts).
enum InvoicePaymentStatus {
  NOT_SYNCED
  UNPAID
  PART_PAID
  PAID
  VOID
}

// Append-only log of invoice payment-status changes (ADR-072), one row per
// InvoicePaymentStatusChanged event. Timescale hypertable on occurredAt (the
// provider's update time), same rules as the other fact tables (ADR-052).
model InvoiceFact {
  eventId              String
  distributorId        String
  exportId             String
  orderId              String
  customerId           String
  fromStatus           InvoicePaymentStatus
  toStatus             InvoicePaymentStatus
  currency             String
  total                Decimal              @db.Decimal(12, 2)
  amountPaid           Decimal              @db.Decimal(12, 2)
  amountDue            Decimal              @db.Decimal(12, 2)
  issueDate            DateTime?            @db.Date
  dueDate              DateTime?            @db.Date
  fullyPaidOn          DateTime?            @db.Date
  occurredAt           DateTime // UTC business timestamp; hypertable partitioning column
  distributorLocalDate DateTime             @db.Date
  recordedAt           DateTime             @default(now())

  @@id([eventId, occurredAt])
  @@index([distributorId, distributorLocalDate])
  @@index([exportId])
  @@index([occurredAt])
  @@map("invoice_facts")
}

// One row per exported invoice, projected from invoice_facts: its latest
// payment status and the dates payment performance is measured from.
model InvoiceAnalyticsState {
  exportId      String               @id
  distributorId String
  customerId    String
  orderId       String
  currency      String
  status        InvoicePaymentStatus
  total         Decimal              @db.Decimal(12, 2)
  amountDue     Decimal              @db.Decimal(12, 2)
  issueDate     DateTime?            @db.Date
  dueDate       DateTime?            @db.Date
  fullyPaidOn   DateTime?            @db.Date
  lastEventAt   DateTime
  updatedAt     DateTime             @updatedAt

  @@index([distributorId, customerId])
  @@index([distributorId, fullyPaidOn])
  @@map("invoice_analytics_state")
}

// ─── Acceptance configuration ─────────────────────────────────────────────────

model DistributorSettings {
  distributorId              String              @id
  defaultOrderAcceptanceMode OrderAcceptanceMode @default(MANUAL)
  marketplaceVisible         Boolean             @default(false)
  marketplaceDescription     String?
  tagline                    String?
  aboutText                  String?
  orderNotificationEmails    String[]            @default([])
  processingDays             Int[]               @default([1, 2, 3, 4, 5])
  minimumOrderSpend          Decimal?            @db.Decimal(10, 2)
  // IANA timezone (e.g. "Europe/London") defining this distributor's calendar
  // day/week/month boundaries for analytics period comparisons — see the
  // wholesaler homepage dashboard PRD, §4.1.
  timezone                   String              @default("UTC")
  // ISO 4217 currency code (e.g. "GBP") — this distributor's single trading
  // currency. Order/PriceList/PriceListRule snapshot it at creation time
  // (ADR-032) rather than referencing it live.
  currencyCode               String              @default("GBP")
  // Look-ahead window (days) for surfacing "another delivery to the same
  // address" review suggestions on the Delivery Runs board. Reviewable
  // suggestion only — orders are never auto-moved/merged. No settings UI
  // in the initial native delivery-planning PBI; fixed default of 3.
  nearbyDeliveryWindowDays   Int                 @default(3)
  // The payment term customers without an override get (ADR-075). null =
  // the accounting system decides due dates.
  defaultPaymentTermId       String?
  distributor                Organisation        @relation(fields: [distributorId], references: [id])
  defaultPaymentTerm         PaymentTerm?        @relation("DistributorDefaultPaymentTerm", fields: [defaultPaymentTermId], references: [id])

  @@map("distributor_settings")
}

// ─── Accounting integration ───────────────────────────────────────────────────
// Provider-neutral: Xero is the first AccountingProvider, not the shape of the
// model. Historical rows are kept (never deleted) when a distributor
// disconnects/reconnects — "one active connection per distributor" is enforced
// via connectedDistributorId (see ADR-052): it mirrors distributorId only
// while status is CONNECTED, and is null otherwise. Postgres never treats two
// nulls as equal in a unique index, so disconnected/error/revoked history rows
// (null) never collide with each other, while at most one row per distributor
// can hold a real value there. Maintained automatically by the
// accounting_connections_set_marker trigger (see the
// add_active_marker_triggers migration) — not application code — so the
// rule holds regardless of what writes the row.
//
// A connection is only the login — tokens, status, errors. Everything the
// distributor builds up against the accounting system (cached records, links,
// suggestions, invoices sent, settings) belongs to the AccountingOrganisation
// it logged into, so it survives a reconnect to the same organisation
// (ADR-074).
model AccountingConnection {
  id                       String                     @id @default(cuid())
  distributorId            String
  connectedDistributorId   String?
  accountingOrganisationId String
  provider                 AccountingProvider
  status                   AccountingConnectionStatus
  scopes                   String
  encryptedCredentialData  String
  connectedByUserId        String
  connectedAt              DateTime
  disconnectedAt           DateTime?
  lastSyncedAt             DateTime?
  lastErrorAt              DateTime?
  lastErrorMessage         String?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  distributor              Organisation               @relation(fields: [distributorId], references: [id])
  organisation             AccountingOrganisation     @relation(fields: [accountingOrganisationId], references: [id])

  @@unique([connectedDistributorId])
  @@index([distributorId])
  @@index([accountingOrganisationId])
  @@map("accounting_connections")
}

// One distributor's company in one accounting provider (a Xero organisation,
// a QuickBooks company, …), identified by the provider's own id for it. Every
// connection to that company — first connect, reconnects, a different user of
// the same company — points here, so the data below is never lost to a
// reconnect; only a genuinely different company starts empty (ADR-074).
// distributorId is part of the key: two distributors connecting the same
// provider company each get their own record and never share data.
model AccountingOrganisation {
  id                        String                             @id @default(cuid())
  distributorId             String
  provider                  AccountingProvider
  externalOrganisationId    String
  // Refreshed on every connect — organisations can be renamed.
  name                      String
  invoiceExportTargetStatus AccountingInvoiceTargetStatus      @default(DRAFT)
  createdAt                 DateTime                           @default(now())
  updatedAt                 DateTime                           @updatedAt
  distributor               Organisation                       @relation(fields: [distributorId], references: [id])
  connections               AccountingConnection[]
  externalContacts          ExternalAccountingContact[]
  customerMappings          CustomerAccountingMapping[]
  contactMatchSuggestions   AccountingContactMatchSuggestion[]
  externalProducts          ExternalAccountingProduct[]
  productMappings           ProductAccountingMapping[]
  productMatchSuggestions   AccountingProductMatchSuggestion[]
  externalTaxTypes          ExternalAccountingTaxType[]
  taxTypeMappings           TaxTypeAccountingMapping[]
  taxTypeMatchSuggestions   AccountingTaxTypeMatchSuggestion[]
  invoiceExports            AccountingInvoiceExport[]
  bulkImportJobs            AccountingBulkImportJob[]

  @@unique([distributorId, provider, externalOrganisationId])
  @@index([distributorId])
  @@map("accounting_organisations")
}

// Short-lived, single-use CSRF/correlation row for the OAuth connect flow.
// Xero's callback redirect carries only code+state, no Wholo JWT, so this row
// (not a guard) is what proves the callback belongs to a given distributor.
model AccountingOAuthState {
  id                String             @id @default(cuid())
  state             String             @unique
  provider          AccountingProvider
  distributorId     String
  connectedByUserId String
  createdAt         DateTime           @default(now())
  expiresAt         DateTime

  @@map("accounting_oauth_states")
}

// Locally cached contacts pulled from the connected accounting system (Xero
// initially). Populated only through AccountingConnectionAdapter.listContacts
// — "provider" plus generic field names keep a second provider a pure
// adapter addition, nothing here is Xero-specific.
model ExternalAccountingContact {
  id                       String             @id @default(cuid())
  distributorId            String
  accountingOrganisationId String
  provider                 AccountingProvider
  externalContactId        String
  externalContactCode      String?
  externalAccountNumber    String?
  displayName              String
  email                    String?
  billingLine1             String?
  billingLine2             String?
  billingCity              String?
  billingState             String?
  billingPostcode          String?
  billingCountry           String?
  deliveryLine1            String?
  deliveryLine2            String?
  deliveryCity             String?
  deliveryState            String?
  deliveryPostcode         String?
  deliveryCountry          String?
  isCustomer               Boolean            @default(false)
  isSupplier               Boolean            @default(false)
  isArchived               Boolean            @default(false)
  ignoredAt                DateTime?
  lastExternalUpdatedAt    DateTime?
  lastSyncedAt             DateTime
  rawProviderData          Json
  // Set by AccountingChangeDetectionService when a mapped row's watched
  // fields (displayName, email) differ from the previous sync; cleared only
  // by an explicit admin "Acknowledge" action, never by a later sync.
  changeDetectedAt         DateTime?
  changeAcknowledgedAt     DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  distributor  Organisation                       @relation(fields: [distributorId], references: [id])
  organisation AccountingOrganisation             @relation(fields: [accountingOrganisationId], references: [id])
  // One-to-many, not one-to-one: unlinking soft-deletes (unlinkedAt) rather
  // than hard-deleting, so a contact can accumulate historical mapping rows
  // even though only one is ever active (unlinkedAt IS NULL) at a time.
  mappings     CustomerAccountingMapping[]
  suggestions  AccountingContactMatchSuggestion[]

  @@unique([accountingOrganisationId, externalContactId])
  @@index([distributorId, isCustomer, isArchived])
  @@map("external_accounting_contacts")
}

// Confirmed link between a Wholo customer (TradeRelationship, in the context
// of one distributor) and one cached external contact. Written only by an
// explicit user action (import/confirm/match) — never by the sync/matcher,
// regardless of match confidence.
model CustomerAccountingMapping {
  id                       String                       @id @default(cuid())
  distributorId            String
  accountingOrganisationId String
  tradeRelationshipId      String
  externalContactId        String
  matchMethod              AccountingContactMatchMethod
  linkedByUserId           String
  linkedAt                 DateTime                     @default(now())
  unlinkedAt               DateTime?
  // See ADR-052: true while linked (unlinkedAt is null), null once unlinked —
  // rides along in both uniques below so an unlink-then-relink of the same
  // pair never collides with the closed-out row. Maintained automatically by
  // the customer_accounting_mappings_set_marker trigger (see the
  // add_active_marker_triggers migration) — not application code.
  linkedMarker             Boolean?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  distributor       Organisation              @relation(fields: [distributorId], references: [id])
  organisation      AccountingOrganisation    @relation(fields: [accountingOrganisationId], references: [id])
  tradeRelationship TradeRelationship         @relation(fields: [tradeRelationshipId], references: [id])
  externalContact   ExternalAccountingContact @relation(fields: [externalContactId], references: [id])

  @@unique([accountingOrganisationId, tradeRelationshipId, linkedMarker])
  @@unique([accountingOrganisationId, externalContactId, linkedMarker])
  @@index([distributorId])
  @@map("customer_accounting_mappings")
}

// System-suggested match awaiting human review. The matcher only ever writes
// here; CustomerAccountingMapping rows are created exclusively by an
// explicit confirm/match action, regardless of confidence.
model AccountingContactMatchSuggestion {
  id                           String                       @id @default(cuid())
  distributorId                String
  accountingOrganisationId     String
  externalContactId            String
  suggestedTradeRelationshipId String
  confidence                   Int
  matchMethod                  AccountingContactMatchMethod
  matchReason                  String
  status                       AccountingContactMatchStatus @default(SUGGESTED)
  reviewedByUserId             String?
  reviewedAt                   DateTime?
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt

  distributor                Organisation              @relation(fields: [distributorId], references: [id])
  organisation               AccountingOrganisation    @relation(fields: [accountingOrganisationId], references: [id])
  externalContact            ExternalAccountingContact @relation(fields: [externalContactId], references: [id])
  suggestedTradeRelationship TradeRelationship         @relation(fields: [suggestedTradeRelationshipId], references: [id])

  @@index([distributorId, status])
  @@index([externalContactId, status])
  @@map("accounting_contact_match_suggestions")
}

// Locally cached products/items pulled from the connected accounting system
// (Xero Items initially). Populated only through
// AccountingConnectionAdapter.listProducts — same provider-neutral cache
// pattern as ExternalAccountingContact. Prices are Decimal(12,4): Xero
// serves 4-dp unit prices (unitdp=4); rounding to Wholo's 2-dp Product.price
// happens only at import, never in the cache.
model ExternalAccountingProduct {
  id                       String             @id @default(cuid())
  distributorId            String
  accountingOrganisationId String
  provider                 AccountingProvider
  externalProductId        String
  externalProductCode      String?
  displayName              String
  description              String?
  salesUnitPrice           Decimal?           @db.Decimal(12, 4)
  purchaseUnitPrice        Decimal?           @db.Decimal(12, 4)
  taxCode                  String?
  accountCode              String?
  purchaseTaxCode          String?
  purchaseAccountCode      String?
  isSold                   Boolean            @default(true)
  isPurchased              Boolean            @default(true)
  isTracked                Boolean            @default(false)
  // Xero Items have no archived flag — deleted items simply vanish from the
  // next full fetch, so the sync marks absent rows isActive=false instead.
  isActive                 Boolean            @default(true)
  quantityOnHand           Decimal?           @db.Decimal(12, 4)
  ignoredAt                DateTime?
  lastExternalUpdatedAt    DateTime?
  lastSyncedAt             DateTime
  rawProviderData          Json
  // Set by AccountingChangeDetectionService when a mapped row's watched
  // fields (salesUnitPrice, taxCode) differ from the previous sync; cleared
  // only by an explicit admin "Acknowledge" action, never by a later sync.
  changeDetectedAt         DateTime?
  changeAcknowledgedAt     DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  distributor  Organisation                       @relation(fields: [distributorId], references: [id])
  organisation AccountingOrganisation             @relation(fields: [accountingOrganisationId], references: [id])
  // One-to-many, not one-to-one: unlinking soft-deletes (unlinkedAt) rather
  // than hard-deleting, so a product can accumulate historical mapping rows
  // even though only one is ever active (unlinkedAt IS NULL) at a time.
  mappings     ProductAccountingMapping[]
  suggestions  AccountingProductMatchSuggestion[]

  @@unique([accountingOrganisationId, externalProductId])
  @@index([distributorId, isSold, isActive])
  @@map("external_accounting_products")
}

// Confirmed link between a Wholo Product and one cached external accounting
// product. Written only by an explicit user action (import/confirm/match) —
// never by the sync/matcher, regardless of match confidence.
model ProductAccountingMapping {
  id                       String                       @id @default(cuid())
  distributorId            String
  accountingOrganisationId String
  productId                String
  externalProductId        String
  matchMethod              AccountingProductMatchMethod
  linkedByUserId           String
  linkedAt                 DateTime                     @default(now())
  unlinkedAt               DateTime?
  // See ADR-052: true while linked (unlinkedAt is null), null once unlinked —
  // same pattern as CustomerAccountingMapping.linkedMarker. Maintained
  // automatically by the product_accounting_mappings_set_marker trigger (see
  // the add_active_marker_triggers migration) — not application code.
  linkedMarker             Boolean?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  distributor     Organisation              @relation(fields: [distributorId], references: [id])
  organisation    AccountingOrganisation    @relation(fields: [accountingOrganisationId], references: [id])
  product         Product                   @relation(fields: [productId], references: [id])
  externalProduct ExternalAccountingProduct @relation(fields: [externalProductId], references: [id])

  @@unique([accountingOrganisationId, productId, linkedMarker])
  @@unique([accountingOrganisationId, externalProductId, linkedMarker])
  @@index([distributorId])
  @@map("product_accounting_mappings")
}

// System-suggested product match awaiting human review. The matcher only ever
// writes here; ProductAccountingMapping rows are created exclusively by an
// explicit confirm/match action, regardless of confidence.
model AccountingProductMatchSuggestion {
  id                       String                       @id @default(cuid())
  distributorId            String
  accountingOrganisationId String
  externalProductId        String
  suggestedProductId       String
  confidence               Int
  matchMethod              AccountingProductMatchMethod
  matchReason              String
  status                   AccountingProductMatchStatus @default(SUGGESTED)
  reviewedByUserId         String?
  reviewedAt               DateTime?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  distributor      Organisation              @relation(fields: [distributorId], references: [id])
  organisation     AccountingOrganisation    @relation(fields: [accountingOrganisationId], references: [id])
  externalProduct  ExternalAccountingProduct @relation(fields: [externalProductId], references: [id])
  suggestedProduct Product                   @relation(fields: [suggestedProductId], references: [id])

  @@index([distributorId, status])
  @@index([externalProductId, status])
  @@map("accounting_product_match_suggestions")
}

// Locally cached tax rates pulled from the connected accounting system (Xero
// initially). Populated only through AccountingConnectionAdapter.listTaxRates
// — same provider-neutral cache pattern as ExternalAccountingContact/Product,
// with one deviation: Xero's TaxRate has no GUID, only a `taxType` code
// string (e.g. "OUTPUT2") as its natural key, so that's the unique key here
// instead of a separate external-id column.
model ExternalAccountingTaxType {
  id                       String             @id @default(cuid())
  distributorId            String
  accountingOrganisationId String
  provider                 AccountingProvider
  taxType                  String
  displayName              String
  ratePercentage           Decimal            @db.Decimal(6, 4)
  isActive                 Boolean            @default(true)
  ignoredAt                DateTime?
  lastSyncedAt             DateTime
  rawProviderData          Json
  // Set by AccountingChangeDetectionService when a mapped row's watched
  // fields (ratePercentage, isActive, displayName) differ from the previous
  // sync; cleared only by an explicit admin "Acknowledge" action, never by a
  // later sync — the rate itself is never auto-applied to the mapped TaxType.
  changeDetectedAt         DateTime?
  changeAcknowledgedAt     DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  distributor  Organisation                       @relation(fields: [distributorId], references: [id])
  organisation AccountingOrganisation             @relation(fields: [accountingOrganisationId], references: [id])
  mappings     TaxTypeAccountingMapping[]
  suggestions  AccountingTaxTypeMatchSuggestion[]

  @@unique([accountingOrganisationId, taxType])
  @@index([distributorId, isActive])
  @@map("external_accounting_tax_types")
}

// Confirmed link between a Wholo TaxType and one cached external tax rate.
// Written only by an explicit user action (create/confirm/match) — never by
// the sync/matcher, regardless of match confidence.
model TaxTypeAccountingMapping {
  id                       String                       @id @default(cuid())
  distributorId            String
  accountingOrganisationId String
  taxTypeId                String
  externalTaxTypeId        String
  matchMethod              AccountingTaxTypeMatchMethod
  linkedByUserId           String
  linkedAt                 DateTime                     @default(now())
  unlinkedAt               DateTime?
  // See ADR-052: true while linked (unlinkedAt is null), null once unlinked —
  // same pattern as ProductAccountingMapping.linkedMarker. Maintained
  // automatically by the tax_type_accounting_mappings_set_marker trigger (see
  // the add_accounting_tax_types migration) — not application code.
  linkedMarker             Boolean?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  distributor     Organisation              @relation(fields: [distributorId], references: [id])
  organisation    AccountingOrganisation    @relation(fields: [accountingOrganisationId], references: [id])
  taxType         TaxType                   @relation(fields: [taxTypeId], references: [id])
  externalTaxType ExternalAccountingTaxType @relation(fields: [externalTaxTypeId], references: [id])

  // Each Stocdup TaxType has at most one active mapping per organisation (PBI
  // §2: "one unambiguous Xero mapping"), and symmetrically each external tax
  // type maps to at most one Stocdup TaxType — same symmetric pattern as
  // ProductAccountingMapping's two uniques above.
  @@unique([accountingOrganisationId, taxTypeId, linkedMarker])
  @@unique([accountingOrganisationId, externalTaxTypeId, linkedMarker])
  @@index([distributorId])
  @@map("tax_type_accounting_mappings")
}

// System-suggested tax type match awaiting human review. The matcher only
// ever writes here; TaxTypeAccountingMapping rows are created exclusively by
// an explicit confirm/match action, regardless of confidence.
model AccountingTaxTypeMatchSuggestion {
  id                       String                       @id @default(cuid())
  distributorId            String
  accountingOrganisationId String
  externalTaxTypeId        String
  suggestedTaxTypeId       String
  confidence               Int
  matchMethod              AccountingTaxTypeMatchMethod
  matchReason              String
  status                   AccountingTaxTypeMatchStatus @default(SUGGESTED)
  reviewedByUserId         String?
  reviewedAt               DateTime?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  distributor      Organisation              @relation(fields: [distributorId], references: [id])
  organisation     AccountingOrganisation    @relation(fields: [accountingOrganisationId], references: [id])
  externalTaxType  ExternalAccountingTaxType @relation(fields: [externalTaxTypeId], references: [id])
  suggestedTaxType TaxType                   @relation(fields: [suggestedTaxTypeId], references: [id])

  @@index([distributorId, status])
  @@index([externalTaxTypeId, status])
  @@map("accounting_tax_type_match_suggestions")
}

// One row per (connection, order) invoice export attempt-set — the business
// idempotency guard for external invoice creation (the worker's provider call
// additionally carries an idempotency key derived from id + retryCount).
// Retries reuse the row; the unique constraint means a single order can never
// produce two invoices on the same connection.
model AccountingInvoiceExport {
  id                       String                        @id @default(cuid())
  distributorId            String
  accountingOrganisationId String
  provider                 AccountingProvider
  orderId                  String
  status                   AccountingInvoiceExportStatus @default(PENDING)
  externalInvoiceId        String?
  externalInvoiceNumber    String?
  // Provider vocabulary, stored verbatim (e.g. Xero "DRAFT"/"AUTHORISED").
  externalInvoiceStatus    String?
  // Synced back from the accounting system (the system of record for
  // invoices and payments, ADR-006) by the invoice status sync. null until the
  // first sync sees the invoice. Amounts are the provider's own figures —
  // amountDue already reflects payments, credit notes and overpayments.
  invoiceState             AccountingInvoiceState?
  invoiceTotal             Decimal?                      @db.Decimal(12, 2)
  amountPaid               Decimal?                      @db.Decimal(12, 2)
  amountCredited           Decimal?                      @db.Decimal(12, 2)
  amountDue                Decimal?                      @db.Decimal(12, 2)
  // Calendar dates in the accounting organisation's own calendar.
  issueDate                DateTime?                     @db.Date
  dueDate                  DateTime?                     @db.Date
  fullyPaidOn              DateTime?                     @db.Date
  // The due date Stocdup asked for when it created the invoice (the order's
  // calculated dueDate, ADR-075). dueDate above is what the accounting system
  // says now — it wins for display, since that system can change it.
  requestedDueDate         DateTime?                     @db.Date
  providerUpdatedAt        DateTime?
  stateSyncedAt            DateTime?
  exportedAt               DateTime?
  failedAt                 DateTime?
  errorCode                String?
  errorMessage             String?
  retryCount               Int                           @default(0)
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt

  distributor  Organisation           @relation(fields: [distributorId], references: [id])
  organisation AccountingOrganisation @relation(fields: [accountingOrganisationId], references: [id])
  order        Order                  @relation(fields: [orderId], references: [id])

  @@unique([accountingOrganisationId, orderId])
  // Lookup for the status sync (and one Stocdup row per provider invoice).
  // externalInvoiceId is null until the export completes; Postgres treats
  // nulls as distinct, so unexported rows never collide.
  @@unique([accountingOrganisationId, externalInvoiceId])
  @@index([distributorId, status])
  @@index([distributorId, invoiceState])
  @@index([orderId])
  @@map("accounting_invoice_exports")
}

// A bulk "import everything selected" run against one connection's cached
// products or contacts, processed asynchronously by AccountingBulkImportProcessor.
// selection captures how the caller chose the target set — either explicit
// ids, or a filter (status/type/search) re-resolved against current data at
// process time, never trusted as a client-supplied snapshot. results is a
// flat per-item report (no child table — fine at this feature's volumes);
// updatedAt doubles as the processor's crash-recovery heartbeat (see
// PROCESSING_STALE_MS in the processor).
model AccountingBulkImportJob {
  id                       String                         @id @default(cuid())
  distributorId            String
  accountingOrganisationId String
  recordType               AccountingBulkImportRecordType
  requestedByUserId        String
  status                   AccountingBulkImportJobStatus  @default(QUEUED)
  honourSuggestions        Boolean                        @default(false)
  selection                Json
  totalCount               Int                            @default(0)
  importedCount            Int                            @default(0)
  matchedCount             Int                            @default(0)
  skippedCount             Int                            @default(0)
  failedCount              Int                            @default(0)
  results                  Json                           @default("[]")
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  completedAt              DateTime?

  distributor  Organisation           @relation(fields: [distributorId], references: [id])
  organisation AccountingOrganisation @relation(fields: [accountingOrganisationId], references: [id])

  @@index([distributorId, createdAt])
  @@map("accounting_bulk_import_jobs")
}

// Generic tracking row for one in-progress/last "pull" from an external source
// into Wholo. Deliberately source-agnostic: sourceType / sourceRef /
// resourceType are opaque strings so a new ingestion source (delivery, stock,
// …) reuses this table with no migration. Known values today:
//   sourceType   "accounting"
//   sourceRef    AccountingConnection.id
//   resourceType "contact" | "product" | "tax_type"
// One row per (sourceType, sourceRef, resourceType) — reset and reused on each
// run, no history kept (see ADR-061). updatedAt doubles as the processor's
// crash-recovery heartbeat, exactly like AccountingBulkImportJob.
model IngestionRun {
  id               String              @id @default(cuid())
  distributorId    String
  sourceType       String
  sourceRef        String
  resourceType     String
  status           IngestionRunStatus  @default(QUEUED)
  trigger          IngestionRunTrigger
  recordsTotal     Int?
  recordsProcessed Int                 @default(0)
  recordsFailed    Int                 @default(0)
  // Delta breakdown of recordsProcessed, populated as the run completes and
  // read by the "sync complete" panel. created + updated + removed + unchanged
  // does not have to equal recordsProcessed (removed rows are reconciled
  // separately from the fetched set), so the panel derives "unchanged" as
  // recordsProcessed - created - updated.
  recordsCreated   Int                 @default(0)
  recordsUpdated   Int                 @default(0)
  recordsRemoved   Int                 @default(0)
  // Generic secondary counter — for accounting sync this is "match suggestions created".
  detailCount      Int                 @default(0)
  errorMessage     String?
  queuedAt         DateTime            @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?
  // Scheduling (ADR-061 "Scheduling"). The scheduler enqueues every row whose
  // nextRunAt has passed, then advances it by whole intervals from its own
  // slot (no drift). null = not yet scheduled; the scheduler seeds it.
  nextRunAt        DateTime?
  // Opaque incremental position produced by the source adapter and handed
  // back on the next pull (e.g. a modified-since timestamp). null = the next
  // pull must be full.
  cursor           String?
  // Last successful FULL pull — drives the periodic full reconcile that
  // incremental pulls can't replace (deletions, re-matching).
  lastFullRunAt    DateTime?
  // Last successful pull of any kind. Survives later failed attempts (this
  // row is reused, so `status` only describes the latest attempt) — "has
  // ever synced" and "last synced" come from here (ADR-061).
  lastSucceededAt  DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  distributor Organisation @relation(fields: [distributorId], references: [id])

  @@unique([sourceType, sourceRef, resourceType])
  @@index([distributorId])
  @@index([sourceType, nextRunAt])
  @@map("ingestion_runs")
}

model TraderCustomerSettings {
  id                          String               @id @default(cuid())
  tradeRelationshipId         String               @unique
  orderAcceptanceModeOverride OrderAcceptanceMode?
  priceListId                 String?
  deliveryProfileId           String?
  paymentTermId               String?
  tradeRelationship           TradeRelationship    @relation(fields: [tradeRelationshipId], references: [id])
  priceList                   PriceList?           @relation(fields: [priceListId], references: [id])
  deliveryProfile             DeliveryProfile?     @relation(fields: [deliveryProfileId], references: [id])
  paymentTerm                 PaymentTerm?         @relation(fields: [paymentTermId], references: [id])

  @@map("trader_customer_settings")
}

// ─── Outbox ───────────────────────────────────────────────────────────────────

model OutboxEvent {
  id            String            @id @default(cuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  publishedAt   DateTime?
  failedAt      DateTime?
  retryCount    Int               @default(0)
  errorMessage  String?

  @@index([status, createdAt])
  @@map("outbox_events")
}

// Human-readable "who did what" trail, read back by the UI — unlike OutboxEvent
// (fire-and-forget, never queried per-tenant). entityType/entityId is a
// polymorphic reference (no FK, same pattern as OutboxEvent.aggregateType/Id)
// so this scales to future entities (products, customers, ...) with no migration.
model AuditLog {
  id            String    @id @default(cuid())
  distributorId String
  entityType    String
  entityId      String
  action        String
  actorType     ActorType
  actorUserId   String?
  actorName     String?
  summary       String
  changes       Json?
  createdAt     DateTime  @default(now())

  distributor Organisation @relation(fields: [distributorId], references: [id])

  @@index([distributorId, entityType, entityId, createdAt])
  @@map("audit_logs")
}

// ─── Notifications ────────────────────────────────────────────────────────────
// Notification = something happened; NotificationDelivery = an attempt to tell
// someone via a specific channel. Unique constraints provide business
// idempotency against at-least-once outbox/queue delivery.

model Notification {
  id            String           @id @default(cuid())
  type          NotificationType
  distributorId String
  orderId       String?
  dedupeKey     String           @unique
  payload       Json
  createdAt     DateTime         @default(now())

  order      Order?                 @relation(fields: [orderId], references: [id])
  deliveries NotificationDelivery[]

  @@index([distributorId, createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String                     @id @default(cuid())
  notificationId String
  channel        NotificationChannel
  audience       NotificationAudience
  recipient      String
  status         NotificationDeliveryStatus @default(PENDING)
  attemptCount   Int                        @default(0)
  sentAt         DateTime?
  failedAt       DateTime?
  errorMessage   String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id])

  @@unique([notificationId, channel, recipient])
  @@index([status, createdAt])
  @@map("notification_deliveries")
}

// ─── Admin notifications ───────────────────────────────────────────────────────
// Distinct from Notification/NotificationDelivery above: those are the
// transactional email pipeline (order/invite emails, org/email-keyed, no read
// state). AdminNotification is a per-admin-user in-app inbox — userId is a
// User.id, readAt tracks read state, and it has no delivery/channel concept
// (in-app is the only channel by design; a future push/email fan-out from the
// same event would call the existing Notification pipeline alongside this,
// not fold into it). type is a plain string rather than an enum: this is
// meant to be a generalized mechanism with more than one producer over time,
// and an enum would need a migration per new producer.
model AdminNotification {
  id             String    @id @default(cuid())
  organisationId String
  userId         String
  type           String
  title          String
  body           String
  linkPath       String?
  payload        Json      @default("{}")
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("admin_notifications")
}

// ─── Catalogues ───────────────────────────────────────────────────────────────

model Catalogue {
  id            String              @id @default(cuid())
  distributorId String
  name          String
  description   String?
  deletedAt     DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  distributor   Organisation        @relation("DistributorCatalogues", fields: [distributorId], references: [id])
  products      CatalogueProduct[]
  customers     CustomerCatalogue[]

  @@index([distributorId])
  @@map("catalogues")
}

model CatalogueProduct {
  catalogueId String
  productId   String
  createdAt   DateTime  @default(now())
  catalogue   Catalogue @relation(fields: [catalogueId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  @@id([catalogueId, productId])
  @@map("catalogue_products")
}

model CustomerCatalogue {
  tradeRelationshipId String
  catalogueId         String
  createdAt           DateTime          @default(now())
  tradeRelationship   TradeRelationship @relation(fields: [tradeRelationshipId], references: [id])
  catalogue           Catalogue         @relation(fields: [catalogueId], references: [id])

  @@id([tradeRelationshipId, catalogueId])
  @@map("customer_catalogues")
}

// ─── Price Lists ──────────────────────────────────────────────────────────────

model PriceList {
  id               String                   @id @default(cuid())
  distributorId    String
  name             String
  description      String?
  currency         String                   @default("GBP")
  isDefault        Boolean                  @default(false)
  active           Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  distributor      Organisation             @relation("DistributorPriceLists", fields: [distributorId], references: [id])
  rules            PriceListRule[]
  customerSettings TraderCustomerSettings[]
  basedOnRules     PriceListRule[]          @relation("BasePriceListRules")

  @@index([distributorId, active])
  @@index([distributorId, isDefault])
  @@map("price_lists")
}

model PriceListRule {
  id                 String                         @id @default(cuid())
  distributorId      String
  priceListId        String
  selectorType       PriceListRuleSelectorType
  productId          String?
  productVariantId   String?
  minQuantity        Int                            @default(1)
  valueType          PriceListRuleValueType         @default(FIXED_PRICE)
  unitPrice          Decimal?                       @db.Decimal(10, 2)
  discountPercentage Decimal?                       @db.Decimal(5, 2)
  discountBaseType   PriceListRuleDiscountBaseType?
  basePriceListId    String?
  currency           String                         @default("GBP")
  sortOrder          Int                            @default(0)
  active             Boolean                        @default(true)
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  priceList          PriceList                      @relation(fields: [priceListId], references: [id])
  product            Product?                       @relation("ProductPriceListRules", fields: [productId], references: [id])
  basePriceList      PriceList?                     @relation("BasePriceListRules", fields: [basePriceListId], references: [id])

  @@index([priceListId, active])
  @@index([priceListId, selectorType, productId])
  @@index([distributorId])
  @@map("price_list_rules")
}

// ─── Payment Terms ────────────────────────────────────────────────────────────
// Named, reusable due-date rules (ADR-075). The distributor default lives on
// DistributorSettings.defaultPaymentTermId; a customer override on
// TraderCustomerSettings.paymentTermId. Never hard-deleted — orders snapshot
// the rule, and the id is kept for audit.
//
// systemKey identifies a built-in term ("ACCOUNTING_SYSTEM_DEFAULT") — one per
// distributor, created on demand and never editable. null for distributor-made
// terms; Postgres treats nulls as distinct, so those never collide.

model PaymentTerm {
  id                     String                   @id @default(cuid())
  distributorId          String
  name                   String
  type                   PaymentTermType
  days                   Int?
  // ISO weekday, 1 = Monday … 7 = Sunday.
  dayOfWeek              Int?
  // 1–31; clamped to the last day of shorter months.
  dayOfMonth             Int?
  systemKey              String?
  active                 Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  distributor            Organisation             @relation("DistributorPaymentTerms", fields: [distributorId], references: [id])
  customerSettings       TraderCustomerSettings[]
  defaultForDistributors DistributorSettings[]    @relation("DistributorDefaultPaymentTerm")

  @@unique([distributorId, systemKey])
  @@index([distributorId, active])
  @@map("payment_terms")
}

// ─── Tax Types ────────────────────────────────────────────────────────────────
// Wholesaler-owned tax types (PBI: import/map/apply Xero tax types, Phase 1).
// Isolated per distributor, assigned to products, applied at order-line
// calculation (Phase 2). Not yet linked to Xero — that's Phase 3/4.

model TaxType {
  id                         String                             @id @default(cuid())
  distributorId              String
  name                       String
  classification             TaxClassification
  ratePercentage             Decimal                            @db.Decimal(5, 2)
  active                     Boolean                            @default(true)
  // System-seeded 0% fallback, one per distributor, created by the one-off
  // backfill script (apps/api/src/scripts/backfill-default-tax-types.ts) so
  // pre-existing products stay orderable once taxTypeId exists. Never
  // created by user action; admin UI should flag products still on it.
  isDefault                  Boolean                            @default(false)
  createdAt                  DateTime                           @default(now())
  updatedAt                  DateTime                           @updatedAt
  distributor                Organisation                       @relation("DistributorTaxTypes", fields: [distributorId], references: [id])
  products                   Product[]
  cartOrderLines             CartOrderLine[]
  accountingMappings         TaxTypeAccountingMapping[]
  accountingMatchSuggestions AccountingTaxTypeMatchSuggestion[]

  @@index([distributorId, active])
  @@map("tax_types")
}

// ─── Delivery Profiles ───────────────────────────────────────────────────────

model DeliveryProfile {
  id                          String                      @id @default(cuid())
  distributorId               String
  name                        String
  active                      Boolean                     @default(true)
  defaultWeekdays             Int[]                       @default([])
  defaultCutoffTime           String                      @default("17:00")
  defaultCutoffProcessingDays Int                         @default(1)
  speciallyEnabledDates       DateTime[]                  @db.Date
  speciallyDisabledDates      DateTime[]                  @db.Date
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  distributor                 Organisation                @relation("DistributorDeliveryProfiles", fields: [distributorId], references: [id])
  cutoffRules                 DeliveryProfileCutoffRule[]
  customerSettings            TraderCustomerSettings[]

  @@index([distributorId, active])
  @@map("delivery_profiles")
}

model DeliveryProfileCutoffRule {
  id                           String          @id @default(cuid())
  deliveryProfileId            String
  weekday                      Int
  cutoffTime                   String
  processingDaysBeforeDelivery Int
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt
  deliveryProfile              DeliveryProfile @relation(fields: [deliveryProfileId], references: [id], onDelete: Cascade)

  @@unique([deliveryProfileId, weekday])
  @@map("delivery_profile_cutoff_rules")
}

// ─── Delivery Routes & Runs (native planning) ────────────────────────────────
// DeliveryRoute is the reusable definition (which customers normally travel
// together, and in what usual drop order) — deliberately separate from
// DeliveryProfile, which governs *when* a customer may be delivered to.
// DeliveryRun is a dated occurrence created lazily from an accepted order;
// DeliveryRunOrder is that order's allocation within a run. Both carry
// nullable provider-compatibility fields (source/externalProvider/
// externalId/vehicle*/provider*) so a future delivery-provider integration
// (e.g. SolBox) is additive — one adapter, following the same
// provider-neutral pattern as ADR-051's accounting integration — never a
// schema rewrite. This PBI only ever writes the STOCDUP-native values.

enum DeliveryRunStatus {
  OPEN
  READY
}

enum DeliveryRunSource {
  STOCDUP
  // Future provider values (e.g. SOLBOX) are appended here only, when a real
  // integration is built — no other schema change needed.
}

enum DeliveryAllocationSource {
  DEFAULT_ROUTE
  MANUAL
  EXTERNAL_PROVIDER
}

enum DeliveryRunOrderStatus {
  PLANNED
  // Later execution states (IN_TRANSIT, DELIVERED, FAILED, ...) are reserved
  // for a future provider integration; this PBI only ever writes PLANNED.
}

model DeliveryRoute {
  id                String   @id @default(cuid())
  distributorId     String
  name              String
  code              String?
  // Free-text usual driver name, copied onto a dated run when it's first
  // created (changing that run's driver never changes this default). No
  // Driver/staff directory model exists yet, so this is a bare label, not an
  // FK — a future real driver directory would need a migration to backfill
  // relationships from these free-text values.
  defaultDriverName String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  distributor Organisation            @relation("DistributorDeliveryRoutes", fields: [distributorId], references: [id])
  customers   DeliveryRouteCustomer[]
  runs        DeliveryRun[]

  @@index([distributorId, active])
  @@map("delivery_routes")
}

// "A customer has at most one active default route within a distributor" is
// enforced via activeDistributorCustomerId (ADR-052 marker-column pattern):
// it mirrors `${distributorId}:${customerId}` only while removedAt is null,
// and is null otherwise. Maintained by a BEFORE INSERT OR UPDATE trigger
// (see the add_delivery_route_active_marker_trigger migration) — not
// application code — so the rule holds regardless of what writes the row.
model DeliveryRouteCustomer {
  id                  String    @id @default(cuid())
  routeId             String
  customerId          String
  defaultDropPosition Int
  assignedAt          DateTime  @default(now())
  assignedByUserId    String
  removedAt           DateTime?
  removedByUserId     String?

  activeDistributorCustomerId String?

  route    DeliveryRoute @relation(fields: [routeId], references: [id])
  customer Organisation  @relation("DeliveryRouteCustomerAssignments", fields: [customerId], references: [id])

  @@unique([activeDistributorCustomerId])
  @@index([routeId, defaultDropPosition])
  @@index([customerId])
  @@map("delivery_route_customers")
}

model DeliveryRun {
  id            String   @id @default(cuid())
  distributorId String
  // Nullable: required for native route-created runs, but left open for a
  // future provider-supplied run with no native route mapping.
  routeId       String?
  deliveryDate  DateTime @db.Date
  // Snapshot of the route's name at run-creation time — a run created under
  // "Yorkshire" stays labelled "Yorkshire" even if the route is later
  // renamed, same reasoning as Order's *Snapshot fields.
  name          String
  // Actual driver for this date, independent of the route's default driver.
  driverName    String?
  vehicleId     String?
  vehicleName   String?

  status DeliveryRunStatus @default(OPEN)

  source           DeliveryRunSource @default(STOCDUP)
  externalProvider String?
  externalId       String?
  optimised        Boolean           @default(false)

  readyAt       DateTime?
  readyByUserId String?

  // First optimistic-concurrency column in this schema, deliberately scoped
  // to this table only. Bumped on every mutating write (move in/out,
  // reorder, driver change, mark-ready, reopen); mutating endpoints require
  // the caller's last-known value and reject with a conflict if it's stale.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  distributor Organisation       @relation("DistributorDeliveryRuns", fields: [distributorId], references: [id])
  route       DeliveryRoute?     @relation(fields: [routeId], references: [id])
  orders      DeliveryRunOrder[]

  // Find-or-lazily-create key for "the route's OPEN run for this date" —
  // Postgres never treats two NULLs as equal, so this never collides across
  // the (out-of-scope-for-this-PBI) routeId: null case.
  @@unique([distributorId, routeId, deliveryDate])
  @@index([distributorId, deliveryDate, status])
  @@map("delivery_runs")
}

// "An order has at most one active run allocation" is enforced via
// activeOrderId (ADR-052 marker-column pattern): mirrors orderId only while
// removedAt is null, else null. Maintained by a BEFORE INSERT OR UPDATE
// trigger — not application code.
model DeliveryRunOrder {
  id               String                   @id @default(cuid())
  runId            String
  orderId          String
  deliverySequence Int?
  // Reserved, provider-compatible relative sequence; unpopulated this PBI.
  relativeSequence Int?
  allocationSource DeliveryAllocationSource
  deliveryStatus   DeliveryRunOrderStatus   @default(PLANNED)

  // Reserved provider-compatibility fields — all nullable, unpopulated by
  // this PBI (see the section header above).
  providerStatus String?
  plannedAt      DateTime?
  etaAt          DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  signedBy       String?
  providerData   Json?

  assignedAt       DateTime  @default(now())
  // Nullable: system-driven allocation (allocationSource DEFAULT_ROUTE /
  // EXTERNAL_PROVIDER) has no acting user, same reasoning as
  // Order.acceptedByUserId being nullable for auto-accept. Only a MANUAL
  // (human-driven) move ever sets this.
  assignedByUserId String?
  removedAt        DateTime?
  removedByUserId  String?

  activeOrderId String?

  run   DeliveryRun @relation(fields: [runId], references: [id])
  order Order       @relation(fields: [orderId], references: [id])

  @@unique([activeOrderId])
  @@index([runId, deliverySequence])
  @@index([orderId])
  @@map("delivery_run_order")
}

// ─── Driver delivery links (Increment 2 — online QR delivery) ────────────────
//
// The QR/URL a driver opens is a stateless signed pointer to Order.id
// (DeliveryTokenSigner, apps/api/src/delivery-links) — never minted, stored,
// or expired. It is durable, not single-use: it must keep resolving to the
// same pending-delivery view indefinitely (a driver can't obtain a
// replacement QR code in the field) for as long as no row below exists for
// that order. Only the *outcome write* is single-use — enforced by the
// @unique on orderId below, not by any property of the token itself.

enum DeliveryOutcomeType {
  DELIVERED
  UNABLE_TO_DELIVER
  // PARTIALLY_DELIVERED reserved — appended by a future increment without a
  // destructive migration, matching DeliveryRunOrderStatus's existing
  // "reserved for later" comment style.
}

enum UnableToDeliverReason {
  CUSTOMER_CLOSED
  CUSTOMER_REFUSED
  UNABLE_TO_ACCESS_PREMISES
  INCORRECT_ADDRESS
  OTHER
}

enum DeliveryDropMethod {
  HANDED_TO_PERSON
  LEFT_IN_SAFE_LOCATION
  // Delivered-outcome sub-classification (PRD §9.1 / §10). LEFT_IN_SAFE_LOCATION
  // and its "where it was left" / photo-proof detail columns are built by a
  // later increment — appended here without a destructive migration.
}

model OrderDeliveryOutcome {
  id      String @id @default(cuid())
  orderId String @unique

  outcome DeliveryOutcomeType

  // Delivered-only, both optional — never blocking submission (PRD 9.1)
  recipientName String?
  notes         String?

  // Unable-to-deliver-only
  unableReason     UnableToDeliverReason?
  unableReasonNote String? // required by service-layer validation only when reason = OTHER

  // Delivered-only: how the order changed hands. Null for UNABLE_TO_DELIVER and
  // for rows created before this column existed. Required by service-layer
  // validation when outcome = DELIVERED.
  dropMethod DeliveryDropMethod?

  // Handed-to-person proof: signature_pad stroke groups (pad.toData()) stored
  // verbatim as a stroke-vector blob — never a raster image. Shape:
  //   { format: 'signature_pad', version, width, height, strokes: [...] }
  // width/height are the capture-time canvas CSS pixel size, needed to replay
  // the strokes faithfully later. Never exposed on the public QR confirmation
  // (PRD §13/§23). Required by service-layer validation when
  // dropMethod = HANDED_TO_PERSON.
  signature Json?

  // Device-reported capture time, distinct from recordedAt (server time) —
  // PRD §11 requires both. Client-supplied, therefore advisory.
  capturedAt DateTime?

  // Structured device location captured once during the delivery (PRD §11) —
  // never read from photo EXIF. All-null coords with locationUnavailable = true
  // records that no fix was obtained (permission refused / timeout / no API).
  // Client-supplied, advisory. Never exposed on the public QR confirmation.
  latitude            Float?
  longitude           Float?
  locationAccuracyM   Float?
  locationCapturedAt  DateTime?
  locationUnavailable Boolean   @default(false)

  recordedAt          DateTime @default(now())
  // Distributor visibility requires showing "whether the result was
  // submitted using unauthenticated QR access" — always true this round,
  // the only submission path that exists; reserved as a real column so a
  // future authenticated initial-submission path wouldn't need a migration.
  submittedViaQrToken Boolean  @default(true)

  // Reserved for Increment 4 (authenticated driver self-correction) —
  // nullable and unpopulated by this PBI, which only ever creates this row
  // once via the anonymous endpoint and never updates it. A future
  // authenticated endpoint sets these when a driver corrects their own
  // previously submitted outcome. Correction is never possible through the
  // anonymous QR link itself — only through authenticated driver login.
  correctedAt       DateTime?
  correctedByUserId String?

  order  Order                @relation(fields: [orderId], references: [id])
  photos OrderDeliveryPhoto[]

  @@map("order_delivery_outcomes")
}

// Delivery-proof photographs (PRD §9.1/§11). Uploaded eagerly and individually
// via the public delivery-link endpoint while the delivery is still PENDING,
// then linked to the outcome (outcomeId) when it is submitted. Optional — photo
// capture is never a gate (PRD §25). Bytes live in R2; this row holds only the
// keys, following AssetImage / ADR-038. Not exposed on the public QR
// confirmation (PRD §13).
model OrderDeliveryPhoto {
  id            String  @id @default(cuid())
  orderId       String
  distributorId String // denormalised — R2 key namespacing + future tenant queries
  outcomeId     String? // null until the outcome is submitted

  variants        Json // { full: "<r2Key>", thumb: "<r2Key>" } — keys, not URLs
  sourceMimeType  String
  sourceSizeBytes Int
  sourceWidth     Int?
  sourceHeight    Int?
  capturedAt      DateTime? // device-reported photo time, advisory
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())

  order   Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  outcome OrderDeliveryOutcome? @relation(fields: [outcomeId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_delivery_photos")
}

// ─── Order-as (order on behalf of customer) ──────────────────────────────────

model OrderAsSession {
  id                  String   @id // crypto.randomBytes(24).toString('base64url')
  adminUserId         String
  tradeRelationshipId String
  customerId          String // denormalised from tradeRelationship.customerId for fast interceptor access
  distributorId       String // denormalised from tradeRelationship.distributorId for fast interceptor access
  expiresAt           DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  adminUser         User                   @relation("AdminOrderAsSessions", fields: [adminUserId], references: [id])
  tradeRelationship TradeRelationship      @relation(fields: [tradeRelationshipId], references: [id], onDelete: Cascade)
  customer          Organisation           @relation("OrderAsCustomer", fields: [customerId], references: [id])
  distributor       Organisation           @relation("OrderAsDistributor", fields: [distributorId], references: [id])
  deliveryTokens    OrderAsDeliveryToken[]

  @@unique([adminUserId, tradeRelationshipId])
  @@map("order_as_sessions")
}

model OrderAsDeliveryToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  sessionId String
  expiresAt DateTime
  usedAt    DateTime?

  session OrderAsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("order_as_delivery_tokens")
}

// ─── Asset Images ─────────────────────────────────────────────────────────────

model AssetImage {
  id              String   @id
  assetType       String
  entityId        String
  distributorId   String
  variants        Json
  dominantColor   String?
  sourceFilename  String?
  sourceMimeType  String
  sourceSizeBytes Int
  sourceWidth     Int?
  sourceHeight    Int?
  sortOrder       Int      @default(0)
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([assetType, entityId, sortOrder])
  @@index([distributorId])
  @@map("asset_images")
}
