# apps/www — copy to .env.local for local dev (values below are the local defaults).

# Canonical site URL — absolute links in metadata / OG / sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3040

# Register-form email (self-contained; does NOT use apps/api's mail stack).
# Local: point at the in-cluster MailHog via a port-forward:
#   kubectl port-forward svc/wholo-mailhog 1025:1025
# Live: PurelyMail SMTP (see helm/wholo/values.live.yaml — www.smtp.*).
WWW_SMTP_HOST=localhost
WWW_SMTP_PORT=1025
WWW_SMTP_SECURE=false
WWW_SMTP_USER=
WWW_SMTP_PASS=

# From/To for lead submissions.
LEADS_FROM=leads@stocdup.com
LEADS_TO=leads@stocdup.com
