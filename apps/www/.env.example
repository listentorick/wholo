# apps/www — copy to .env.local for local dev (values below are the local defaults).

# Canonical site URL — absolute links in metadata / OG / sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3040

# Register-form email (self-contained; does NOT use apps/api's mail stack).
# Local: point at the in-cluster MailHog via a port-forward:
#   kubectl port-forward svc/wholo-mailhog 1025:1025
# Live: PurelyMail SMTP (see helm/wholo/values.live.yaml — www.smtp.*).
WWW_SMTP_HOST=localhost
WWW_SMTP_PORT=1025
WWW_SMTP_SECURE=false
WWW_SMTP_USER=
WWW_SMTP_PASS=

# From/To for lead submissions.
LEADS_FROM=leads@stocdup.com
LEADS_TO=leads@stocdup.com

# --- Analytics (self-hosted Plausible) ---
# Baked into the build. Leave PLAUSIBLE_ENABLED empty for local dev unless you
# have a port-forward to the cluster's Plausible:
#   kubectl port-forward svc/wholo-plausible 8000:8000
PLAUSIBLE_ENABLED=
PLAUSIBLE_DOMAIN=stocdup.com
# Runtime: where the /js/script.js + /api/event rewrites proxy to.
PLAUSIBLE_INTERNAL_URL=http://localhost:8000

# --- Hero A/B experiment ---
# 2+ comma-separated variants (default,growth,operations) turns the experiment
# on and makes `/` per-request. Empty = off, `/` stays static on the default hero.
EXPERIMENT_HERO_VARIANTS=
